# The image build reads only patches/engine/ (docker/Dockerfile is passed with -f); everything else stays out of
# the context: logs/, .state/, .git, models, caches.
**
!patches/
!patches/engine/
!patches/engine/**
# PROMPT_CHUNK=2048's patches reach the image from a staged context (prepare_image), never from here.
patches/engine/chunk2048
