@@ -133,6 +133,7 @@ const Owned = struct {
 };
 
 const env = @import("sys").env;
+const links = @import("cuda_links.zig");
 
 /// The send/recv the prompt exchange will use, connected now, before the weights fill memory (connected on first use,
 /// ibv_reg_mr can fail): direct split (TF_GLM_PREFILL_REDUCE=split) reaches every peer; ring sends to the next rank
@@ -140,6 +141,7 @@ const env = @import("sys").env;
 /// some ranks reach only their neighbours (a ring of four without a switch) nothing is connected across it.
 fn warmPeers(d: *const cuda.Driver, g: *const cuda.tp_group.Group, set: ranks.Settings) !void {
     if (!set.split) return; // gather: all-gathers only, which NCCL's rings connect at the first collective
+    if (set.ring and g.links[0] != null and g.links[1] != null) return; // cuda_links connected both cables
     const bytes = 4 << 20; // a prompt piece's exchange: every channel a large send/recv takes
     var buf = try cuda.DeviceBuffer.alloc(d, 2 * bytes * g.world);
     defer buf.free();
@@ -228,6 +230,11 @@ fn openRank(a: StartArgs, set: ranks.Settings) !Loaded {
     try lib.check(lib.api.ncclCommInitRank(&comm, @intCast(p.world), id, @intCast(p.rank)), "ncclCommInitRank");
     own.group = .{ .lib = lib, .comm = comm, .rank = p.rank, .world = p.world };
     errdefer _ = own.group.lib.api.ncclCommDestroy(own.group.comm);
+    // TF_GLM_PREFILL_REDUCE=ring on a ring without a switch: a two-rank communicator on each cable (cuda_links)
+    if (p.world > 1 and set.ring) if (links.wanted()) |spec| try links.open(gpa, ctx.d, &own.group, spec);
+    errdefer for (own.group.links) |l| if (l != null) {
+        _ = own.group.lib.api.ncclCommDestroy(l);
+    };
     if (p.world > 1) try warmPeers(ctx.d, &own.group, set);
     cuda.p2p_report.afterInit(&diag, .{ .lib = &own.group.lib, .comm = comm, .d = ctx.d, .later = true });
     const cap = capacity(o.context);
diff --git a/zig/src/families/glm/cuda_relay.zig b/zig/src/families/glm/cuda_relay.zig
index 34e681b08..b9bf65770 100644
--- a/zig/src/families/glm/cuda_relay.zig
+++ b/zig/src/families/glm/cuda_relay.zig
@@ -6,20 +6,35 @@ const cuda = @import("cuda");
 /// The ring's plan, shared with every family's row-split exchange (cuda/relay_plan.zig).
 pub const Relay = cuda.relay_plan.Relay;
 
+/// What an exchange posts on: the world communicator, and on a ring without a switch the two-rank link of each cable
+/// (cuda_links: [0] toward the previous rank, this rank its rank 1; [1] toward the next, this rank its rank 0). A ring
+/// step's send to the next rank and receive from the previous go over the links when both are open, as two-rank
+/// broadcasts rooted at the sender: NCCL picks a device of its own for a point-to-point send (on the world communicator
+/// or a link alike), and on a ring cabled port to like port it took one without that peer; a collective keeps to the
+/// link's graph file.
+pub const Wire = struct {
+    comm: cuda.nccl.Comm,
+    links: [2]cuda.nccl.Comm = .{ null, null },
+
+    fn linked(w: Wire) bool {
+        return w.links[0] != null and w.links[1] != null;
+    }
+};
+
 /// A piece's partials (`part`: this rank's fp32 rows) into `room`'s slots on `side`; NCCL keeps a pair's posting order.
-pub fn partials(lib: *const cuda.nccl.Library, comm: cuda.nccl.Comm, side: cuda.Stream, x: Relay, room: u64, part: u64, lo: usize, dims: usize) !void {
+pub fn partials(lib: *const cuda.nccl.Library, comm: Wire, side: cuda.Stream, x: Relay, room: u64, part: u64, lo: usize, dims: usize) !void {
     for (1..x.world) |s| try lib.group(Step{ .lib = lib, .comm = comm, .side = side, .x = x, .s = s, .base = room, .part = part, .lo = lo, .dims = dims }, Step.partials);
 }
 
 /// A piece's glued rows (`rows_of`, bf16) to every rank, each step sending on what the last one brought in.
-pub fn glued(lib: *const cuda.nccl.Library, comm: cuda.nccl.Comm, side: cuda.Stream, x: Relay, rows_of: u64, lo: usize, dims: usize) !void {
+pub fn glued(lib: *const cuda.nccl.Library, comm: Wire, side: cuda.Stream, x: Relay, rows_of: u64, lo: usize, dims: usize) !void {
     for (1..x.world) |s| try lib.group(Step{ .lib = lib, .comm = comm, .side = side, .x = x, .s = s, .base = rows_of, .lo = lo, .dims = dims }, Step.glued);
 }
 
 /// Step `s` of an exchange: its postings, which `Library.group` puts in one group.
 const Step = struct {
     lib: *const cuda.nccl.Library,
-    comm: cuda.nccl.Comm,
+    comm: Wire,
     side: cuda.Stream,
     x: Relay,
     s: usize,
@@ -29,10 +44,16 @@ const Step = struct {
     dims: usize,
 
     fn send(t: Step, src: u64, count: usize, ty: cuda.nccl.DataType) !void {
-        try t.lib.check(t.lib.api.ncclSend(src, count, ty, @intCast(t.x.next()), t.comm, t.side.handle), "ncclSend");
+        // over the link: a broadcast from its rank 0 (this rank) to the next rank, in place. A collective runs on the
+        // link's graph file (its cable's devices); NCCL's point-to-point sends pick a device of their own, and on the
+        // Sparks' ring took the port toward the other neighbour (ibv_modify_qp: connection timed out)
+        if (t.comm.linked()) return t.lib.check(t.lib.api.ncclBroadcast(src, src, count, ty, 0, t.comm.links[1], t.side.handle), "ncclBroadcast (link)");
+        try t.lib.check(t.lib.api.ncclSend(src, count, ty, @intCast(t.x.next()), t.comm.comm, t.side.handle), "ncclSend");
     }
     fn recv(t: Step, dst: u64, count: usize, ty: cuda.nccl.DataType) !void {
-        try t.lib.check(t.lib.api.ncclRecv(dst, count, ty, @intCast(t.x.prev()), t.comm, t.side.handle), "ncclRecv");
+        // over the link: the previous rank's broadcast (it is the link's rank 0), in the order it posts them
+        if (t.comm.linked()) return t.lib.check(t.lib.api.ncclBroadcast(dst, dst, count, ty, 0, t.comm.links[0], t.side.handle), "ncclBroadcast (link)");
+        try t.lib.check(t.lib.api.ncclRecv(dst, count, ty, @intCast(t.x.prev()), t.comm.comm, t.side.handle), "ncclRecv");
     }
     fn partials(t: Step) anyerror!void {
         const x = t.x;
@@ -141,8 +162,8 @@ const Fake = struct {
     fn run(lib: *const cuda.nccl.Library, x: Relay, mode: Mode) !void {
         const side: cuda.Stream = .{ .d = undefined, .handle = null };
         switch (mode) {
-            .ring_partials => try partials(lib, null, side, x, 0, 0, 0, 8),
-            .ring_glued => try glued(lib, null, side, x, 0, 0, 8),
+            .ring_partials => try partials(lib, .{ .comm = null }, side, x, 0, 0, 0, 8),
+            .ring_glued => try glued(lib, .{ .comm = null }, side, x, 0, 0, 8),
             .split_partials => try splitPartials(lib, null, side, x, 0, 0, 0, 8),
             .split_glued => try splitGlued(lib, null, side, x, 0, 0, 8),
         }
