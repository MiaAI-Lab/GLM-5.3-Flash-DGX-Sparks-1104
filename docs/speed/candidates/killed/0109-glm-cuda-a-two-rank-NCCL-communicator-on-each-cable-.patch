diff --git a/zig/src/families/glm/cuda_links.zig b/zig/src/families/glm/cuda_links.zig
new file mode 100644
index 000000000..2d9ff765c
--- /dev/null
+++ b/zig/src/families/glm/cuda_links.zig
@@ -0,0 +1,117 @@
+//! A ring without a switch: a two-rank NCCL communicator for each cable, so TF_GLM_PREFILL_REDUCE=ring's sends and
+//! receives (cuda_relay) leave on the device that reaches the neighbour. On the world communicator NCCL picks a device
+//! for a point-to-point send itself, and on a ring cabled port to like port it took one without that peer about half
+//! the time (ncclGroupEnd: unhandled system error, measured on the four Sparks 2026-11-04). Each link is made with its
+//! own NCCL graph file (TF_GLM_LINK_GRAPHS="<toward previous>,<toward next>"), whose channels name the cable's devices.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const env = @import("sys").env;
+
+/// TF_GLM_LINK_GRAPHS: the two graph files, the previous rank's link then the next rank's; null when unset.
+pub fn wanted() ?[]const u8 {
+    const v = std.c.getenv("TF_GLM_LINK_GRAPHS") orelse return null;
+    const s = std.mem.span(v);
+    return if (s.len == 0) null else s;
+}
+
+/// The two paths of a TF_GLM_LINK_GRAPHS value, or error.BadLinkGraphs.
+pub fn paths(spec: []const u8) ![2][]const u8 {
+    var it = std.mem.splitScalar(u8, spec, ',');
+    const prev = it.next() orelse return error.BadLinkGraphs;
+    const next = it.next() orelse return error.BadLinkGraphs;
+    if (it.next() != null or prev.len == 0 or next.len == 0) return error.BadLinkGraphs;
+    return .{ prev, next };
+}
+
+/// Which link a rank makes first: an even rank its next, an odd rank its previous, so each link's two ranks reach it
+/// together (on an even ring every link joins an even and an odd rank: rank r's next is rank r + 1's previous).
+pub fn order(rank: usize) [2]usize {
+    return if (rank % 2 == 0) .{ 1, 0 } else .{ 0, 1 };
+}
+
+/// Every rank's id for the link to its next rank, gathered over the world communicator; then both links made, each with
+/// its graph file in NCCL_GRAPH_FILE (restored after), and connected by one small exchange each (NCCL_RUNTIME_CONNECT).
+pub fn open(gpa: std.mem.Allocator, d: *const cuda.Driver, g: *cuda.tp_group.Group, spec: []const u8) !void {
+    if (g.world < 4 or g.world % 2 != 0) return error.LinksNeedEvenRing;
+    const files = try paths(spec);
+    var z: [2][:0]u8 = undefined;
+    z[0] = try gpa.dupeSentinel(u8, files[0], 0);
+    defer gpa.free(z[0]);
+    z[1] = try gpa.dupeSentinel(u8, files[1], 0);
+    defer gpa.free(z[1]);
+    const nccl = cuda.nccl;
+    const lib = &g.lib;
+    const per = @sizeOf(nccl.UniqueId);
+    // NCCL_COMM_ID names rank 0's bootstrap root: with it set, an id from ncclGetUniqueId carries that address and a
+    // link's rank 0 tries to open its root there (on another Spark: ncclCommInitRank "unhandled system error"). While
+    // the links are made it names this rank's own address instead (TF_GLM_LINK_ADDR, "<address>:<port>"), restored after.
+    const comm_id: ?[:0]u8 = if (std.c.getenv("NCCL_COMM_ID")) |v| try gpa.dupeSentinel(u8, std.mem.span(v), 0) else null;
+    defer if (comm_id) |v| gpa.free(v);
+    if (comm_id != null) {
+        const addr = std.c.getenv("TF_GLM_LINK_ADDR") orelse {
+            std.log.err("glm links: NCCL_COMM_ID is set, so TF_GLM_LINK_ADDR must name this rank's own <address>:<port> for its links' bootstrap", .{});
+            return error.LinksNeedAddress;
+        };
+        _ = env.setenv("NCCL_COMM_ID", addr, 1);
+    }
+    defer if (comm_id) |v| {
+        _ = env.setenv("NCCL_COMM_ID", v.ptr, 1);
+    };
+    var mine: nccl.UniqueId = undefined;
+    try lib.check(lib.api.ncclGetUniqueId(&mine), "ncclGetUniqueId");
+    var s = try cuda.Stream.init(d, false);
+    defer s.deinit();
+    var dev = try cuda.DeviceBuffer.alloc(d, (g.world + 2) * per);
+    defer dev.free();
+    try dev.upload(g.rank * per, std.mem.asBytes(&mine));
+    try lib.check(lib.api.ncclAllGather(dev.ptr + g.rank * per, dev.ptr, per, .u8, g.comm, s.handle), "ncclAllGather");
+    try s.synchronize();
+    const ids = try gpa.alloc(nccl.UniqueId, g.world);
+    defer gpa.free(ids);
+    try dev.download(0, std.mem.sliceAsBytes(ids));
+    const prev = (g.rank + g.world - 1) % g.world;
+    const saved: ?[:0]u8 = if (std.c.getenv("NCCL_GRAPH_FILE")) |v| try gpa.dupeSentinel(u8, std.mem.span(v), 0) else null;
+    defer if (saved) |v| gpa.free(v);
+    defer if (saved) |v| {
+        _ = env.setenv("NCCL_GRAPH_FILE", v.ptr, 1);
+    };
+    errdefer for (&g.links) |*l| if (l.* != null) {
+        _ = lib.api.ncclCommDestroy(l.*);
+        l.* = null;
+    };
+    for (order(g.rank)) |which| {
+        _ = env.setenv("NCCL_GRAPH_FILE", z[which].ptr, 1);
+        // link 1 (toward the next rank) is this rank's id and this rank its rank 0; link 0 the previous rank's, rank 1
+        const id = if (which == 1) ids[g.rank] else ids[prev];
+        var comm: nccl.Comm = null;
+        try lib.check(lib.api.ncclCommInitRank(&comm, 2, id, @intCast(1 - which)), "ncclCommInitRank (link)");
+        g.links[which] = comm;
+        // connected now (NCCL_RUNTIME_CONNECT=1 connects at first use), in the same order, before the weights fill
+        // memory: one broadcast, the collective cuda_relay posts on a link (it keeps to the graph file's devices)
+        const buf = dev.ptr + g.world * per;
+        try lib.check(lib.api.ncclBroadcast(buf, buf, 1, .f32, 0, comm, s.handle), "ncclBroadcast (link)");
+        try s.synchronize();
+    }
+    std.log.info("glm links: rank {d} has a two-rank NCCL communicator on each cable ({s} toward rank {d}, {s} toward rank {d})", .{ g.rank, files[0], prev, files[1], (g.rank + 1) % g.world });
+}
+
+test "link graphs parse as two paths" {
+    const p = try paths("/a.xml,/b.xml");
+    try std.testing.expectEqualStrings("/a.xml", p[0]);
+    try std.testing.expectEqualStrings("/b.xml", p[1]);
+    try std.testing.expectError(error.BadLinkGraphs, paths("/a.xml"));
+    try std.testing.expectError(error.BadLinkGraphs, paths("/a.xml,/b.xml,/c.xml"));
+    try std.testing.expectError(error.BadLinkGraphs, paths(",/b.xml"));
+}
+
+test "each link's two ranks make it at the same step" {
+    for ([_]usize{ 4, 6, 8 }) |w| for (0..w) |r| {
+        const n = (r + 1) % w; // rank r's link 1 is rank n's link 0
+        const a = order(r);
+        const b = order(n);
+        const step_r = std.mem.indexOfScalar(usize, &a, 1).?;
+        const step_n = std.mem.indexOfScalar(usize, &b, 0).?;
+        try std.testing.expectEqual(step_r, step_n);
+    };
+}
diff --git a/zig/src/families/glm/cuda_native.zig b/zig/src/families/glm/cuda_native.zig
index 4f1ab59d6..02caa5cd3 100644
