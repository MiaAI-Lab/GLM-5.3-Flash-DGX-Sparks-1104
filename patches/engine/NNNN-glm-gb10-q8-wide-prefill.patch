Subject: [PATCH] glm cuda: opt in to a 256-row Q8 prompt tile on GB10

Opt-in TF_GLM_PROMPT_WIDE=1. Same group and accumulation order.
Focused contract registrations, independent FP64 fixture, full-shape baseline bytes.
Measured on a GB10 pair with CUDA 13.0 and Q8 dense weights.

diff --git a/zig/kernels/cuda/glm_mm.cu b/zig/kernels/cuda/glm_mm.cu
--- a/zig/kernels/cuda/glm_mm.cu
+++ b/zig/kernels/cuda/glm_mm.cu
@@ -355,6 +355,17 @@
 GLM_MM_PROMPT2(6)
 GLM_MM_PROMPT2(8)

+// On GB10, twice the rows reuse each packed weight tile. K groups and
+// each output's MMA/FMA order stay identical to glm_mm8_128s2. The caller opts in
+// only for the measured 12576 x 4096 projection at 2048 or more prompt rows.
+extern "C" __global__ void __launch_bounds__(512, 1) glm_mm8_256s2(
+    const __nv_bfloat16* __restrict__ x, long long ldx,
+    const uint32_t* __restrict__ w, const __half* __restrict__ s,
+    void* __restrict__ out, float* __restrict__ part,
+    int f32, int M, int N, int K, int SK) {
+    mm_kernel<8, 256, 4, 2, false, true>(x, ldx, w, s, out, part, f32, M, N, K, SK);
+}
+
 // Two problems of one shape and one K slice in one launch (z picks the problem): the same blocks and sums as two
 // launches of glm_mm*_16 (GLM's KDA f_b and g_b projections of a decode window).
 struct MmPair {
