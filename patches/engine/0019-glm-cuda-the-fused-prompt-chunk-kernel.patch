     if constexpr (FP8) {
-      fetch8(tile);
-      store8(tile);
+      fetch8<KW, UPT, PAGED8>(raw, rsc, tile, start, n, limit, codes8, scales8, scales, tok, r, w, pt, pstep, t, sparse);
+      store8<KW, UPT>(raw, rsc, kvs, tile, t);
       return;
     }
     __nv_bfloat16* dst = kvs + (tile & 1) * KT * KW;
@@ -181,7 +188,7 @@ __device__ void chunks_wide(const __nv_bfloat16* qa, const __nv_bfloat16* lc, co
     }
     __syncthreads();
     if constexpr (FP8) {
-      if (tile + 2 < tiles) fetch8(tile + 2);  // in flight during this tile's math
+      if (tile + 2 < tiles) fetch8<KW, UPT, PAGED8>(raw, rsc, tile + 2, start, n, limit, codes8, scales8, scales, tok, r, w, pt, pstep, t, sparse);  // in flight during this tile's math
     }
     const __nv_bfloat16* kv = kvs + (tile & 1) * KT * KW;
     const int64_t first = start + tile * KT;
@@ -265,7 +272,7 @@ __device__ void chunks_wide(const __nv_bfloat16* qa, const __nv_bfloat16* lc, co
     for (int i = 0; i < MT; ++i)
       for (int hf = 0; hf < 2; ++hf) l[i][hf] = __fmaf_rn(l[i][hf], alpha[i][hf], stat[HB + i * 16 + hf * 8 + g]);
     if constexpr (FP8) {
-      if (tile + 2 < tiles) store8(tile + 2);
+      if (tile + 2 < tiles) store8<KW, UPT>(raw, rsc, kvs, tile + 2, t);
     } else if (tile + 2 < tiles) {
       load_kv(tile + 2);
     }
@@ -284,6 +291,208 @@ __device__ void chunks_wide(const __nv_bfloat16* qa, const __nv_bfloat16* lc, co
     }
