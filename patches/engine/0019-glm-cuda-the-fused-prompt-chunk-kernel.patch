index 4ebee84f..0735cd00 100644
--- a/zig/kernels/cuda/common/mla.cuh
+++ b/zig/kernels/cuda/common/mla.cuh
@@ -36,6 +36,61 @@ __device__ __forceinline__ void ldm4(uint32_t* r, const void* p) {
 // A KW-wide bf16 row's 16-byte unit u in shared memory, swizzled by the row so ldmatrix's eight rows hit eight banks.
 template <int KW = LW>
 __device__ __forceinline__ int wide(int row, int u) { return row * KW + ((u ^ (row & 7)) << 3); }
+
+// E4M3 tiles: each thread's 8-code units in one 8-byte load apiece, all issued before any is converted (fetch8),
+// then converted value for value as before (store8). W is the row width, UPT the units a thread moves a tile; the
+// chunk kernels and the fused kernel read the same cache, so they share this.
+template <int W, int UPT, bool PAGED8>
+__device__ __forceinline__ void fetch8(uint2 (&raw)[UPT], float (&rsc)[UPT], int tile, int64_t start, int64_t n,
+                                       int64_t limit, const unsigned char* codes8, const float* scales8,
+                                       const float* scales, const int* tok, int64_t r, int64_t w, const int* pt,
+                                       int64_t pstep, int t, bool sparse) {
+  const int64_t first = start + tile * KT;
+  if constexpr (PAGED8) {
+    if (sparse) {
+      const unsigned char* scale_bytes = reinterpret_cast<const unsigned char*>(scales);
+#pragma unroll
+      for (int i = 0; i < UPT; ++i) {
+        const int idx = t + i * CHUNK_THREADS, key = idx / (W / 8), u = idx % (W / 8);
+        const int64_t ki = first + key;
+        const bool ok = ki < n;
+        const int s = ok ? tok[r * w + ki] : 0;  // a visible position: 0 <= s < 2^31
+        const int64_t page = ok ? (int64_t)pt[s >> 9] * pstep : 0;  // CH = 512 rows a page
+        const int row = s & (CH - 1);
+        raw[i] = ok ? *reinterpret_cast<const uint2*>(codes8 + page + (row * W + u * 8)) : make_uint2(0u, 0u);
+        rsc[i] = ok ? *reinterpret_cast<const float*>(scale_bytes + page + row * 4) : 1.0f;
+      }
+      return;
+    }
+  }
+#pragma unroll
+  for (int i = 0; i < UPT; ++i) {
+    const int idx = t + i * CHUNK_THREADS, key = idx / (W / 8), u = idx % (W / 8);
+    const int64_t ki = first + key;
+    const bool ok = sparse ? ki < n : ki <= limit;
+    const int64_t src = ok ? (sparse ? (int64_t)tok[r * w + ki] : ki) : 0;
+    raw[i] = ok ? *reinterpret_cast<const uint2*>(codes8 + src * W + u * 8) : make_uint2(0u, 0u);
+    rsc[i] = ok ? scales8[src] : 1.0f;
+  }
+}
+
+template <int W, int UPT>
+__device__ __forceinline__ void store8(const uint2 (&raw)[UPT], const float (&rsc)[UPT], __nv_bfloat16* kvs, int tile, int t) {
+  __nv_bfloat16* dst = kvs + (tile & 1) * KT * W;
+#pragma unroll
+  for (int i = 0; i < UPT; ++i) {
+    const int idx = t + i * CHUNK_THREADS, key = idx / (W / 8), u = idx % (W / 8);
+    const uint32_t wv[2] = {raw[i].x, raw[i].y};
+#pragma unroll
+    for (int j = 0; j < 8; j += 2) {
+      const uint16_t bits = (uint16_t)((wv[j / 4] >> (8 * (j % 4))) & 0xffffu);  // codes j, j + 1 (little-endian)
+      const float2 v = __half22float2(__half2(__nv_cvt_fp8x2_to_halfraw2(bits, __NV_E4M3)));
+      dst[wide<W>(key, u) + j] = __float2bfloat16_rn(__fmul_rn(v.x, rsc[i]));
+      dst[wide<W>(key, u) + j + 1] = __float2bfloat16_rn(__fmul_rn(v.y, rsc[i]));
+    }
+  }
+}
+
 // p's [32][32] rows (64 bytes): unit u of row r.
 __device__ __forceinline__ int narrow(int row, int u) { return row * KT + ((u ^ ((row >> 1) & 3)) << 3); }
 
@@ -88,58 +143,10 @@ __device__ void chunks_wide(const __nv_bfloat16* qa, const __nv_bfloat16* lc, co
   constexpr int UPT = KT * (KW / 8) / CHUNK_THREADS;  // units a thread moves a tile
   uint2 raw[FP8 ? UPT : 1];
   float rsc[FP8 ? UPT : 1];
