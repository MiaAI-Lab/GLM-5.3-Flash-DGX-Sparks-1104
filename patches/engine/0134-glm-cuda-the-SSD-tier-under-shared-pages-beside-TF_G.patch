+test "the sharded pool's disk tier: a restart recalls a state into one part, its latent rows on the new owner alone, the keys on both ranks" {
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    const root = try tmp.dir.realPathFileAlloc(t.io, ".", t.allocator);
