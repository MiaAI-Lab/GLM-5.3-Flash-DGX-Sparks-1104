+fn part0(_: *anyopaque, first: u32) bool {
+    return first / h == 0;
+}
+
+fn part0Free(ptr: *anyopaque) usize {
+    const p: *Parts = @ptrCast(@alignCast(ptr));
+    return p.pools[0].available();
