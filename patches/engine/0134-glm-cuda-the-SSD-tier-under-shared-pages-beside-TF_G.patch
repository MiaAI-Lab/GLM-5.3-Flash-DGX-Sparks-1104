+    fn rowsOk(x: *Rig, pages: []const u32, at: u32, part: u8) !void {
+        for (0..at) |tok| {
+            const r = x.f.row(@intCast(tok));
+            const base = @as(usize, pages[tok / page_tokens] - @as(u32, part) * h) * lat_page + (tok % page_tokens) * lat_row;
