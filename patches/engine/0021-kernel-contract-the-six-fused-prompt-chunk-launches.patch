diff --git a/zig/src/core/contract/glm_fused_records.zig b/zig/src/core/contract/glm_fused_records.zig
new file mode 100644
index 00000000..5400539a
--- /dev/null
+++ b/zig/src/core/contract/glm_fused_records.zig
@@ -0,0 +1,55 @@
+//! GLM's fused prompt-chunk launches: nvcc 13.0's receipts owed, 13.3's in glm_cuda_records.zig.
+//! Each fused launch is its window twin's with the merge folded in: same image, block and shared bytes.
+const std = @import("std");
+const registry = @import("registry.zig");
+const limits = @import("limits.zig");
+
+pub const cuda = [_]registry.CudaRecord{
+    .{ .launch = .{ .name = "glm_glue tf_glm_chunks_16_fused", .symbol = "tf_glm_chunks_16_fused", .image = "glm_glue", .threads = 256, .dynamic = 83328, .opt_in = true, .min_sm = 80 }, .usage = registry.none },
+    .{ .launch = .{ .name = "glm_glue tf_glm_chunks_16_fp8_fused", .symbol = "tf_glm_chunks_16_fp8_fused", .image = "glm_glue", .threads = 256, .dynamic = 83328, .opt_in = true, .min_sm = 80 }, .usage = registry.none },
+    .{ .launch = .{ .name = "glm_glue tf_glm_chunks_16_fp8_paged_fused", .symbol = "tf_glm_chunks_16_fp8_paged_fused", .image = "glm_glue", .threads = 256, .dynamic = 83328, .opt_in = true, .min_sm = 80 }, .usage = registry.none },
+    .{ .launch = .{ .name = "glm_glue tf_glm_chunks_32_fused", .symbol = "tf_glm_chunks_32_fused", .image = "glm_glue", .threads = 256, .dynamic = 101120, .opt_in = true, .min_sm = 80 }, .usage = registry.none },
+    .{ .launch = .{ .name = "glm_glue tf_glm_chunks_32_fp8_fused", .symbol = "tf_glm_chunks_32_fp8_fused", .image = "glm_glue", .threads = 256, .dynamic = 101120, .opt_in = true, .min_sm = 80 }, .usage = registry.none },
+    .{ .launch = .{ .name = "glm_glue tf_glm_chunks_32_fp8_paged_fused", .symbol = "tf_glm_chunks_32_fp8_paged_fused", .image = "glm_glue", .threads = 256, .dynamic = 101120, .opt_in = true, .min_sm = 80 }, .usage = registry.none },
+};
+
+fn twin(fused: registry.CudaRecord) !registry.CudaRecord {
+    const symbol = fused.launch.symbol[0 .. fused.launch.symbol.len - "_fused".len];
+    for (registry.all_cuda) |r| if (std.mem.eql(u8, r.launch.symbol, symbol)) return r;
+    return error.MissingRecord;
+}
+
+test "GLM fused chunks: 13.0 pending, 13.3's receipts fit every SM, and each launch is its window twin's" {
+    for (cuda) |r| {
+        try std.testing.expect(std.mem.endsWith(u8, r.launch.symbol, "_fused"));
+        try std.testing.expect(std.mem.endsWith(u8, r.launch.name, r.launch.symbol));
+        try std.testing.expectEqual(registry.none, registry.usageFor(r, .{ .major = 13, .minor = 0 }));
+        const got = registry.usageFor(r, .{ .major = 13, .minor = 3 });
+        for (limits.sms, got) |sm, u| {
+            try std.testing.expect(u.regs > 0 and u.bound == r.launch.threads);
+            var text: std.ArrayList(u8) = .empty;
+            defer text.deinit(std.testing.allocator);
+            try std.testing.expectEqual(@as(usize, 0), try limits.cuda(r.launch, u, sm, &text, std.testing.allocator));
+        }
+        // the merge folds into the same block: the twin's image, threads, shared bytes and bound
+        const w = try twin(r);
+        try std.testing.expectEqualStrings(w.launch.image, r.launch.image);
+        try std.testing.expectEqual(w.launch.threads, r.launch.threads);
+        try std.testing.expectEqual(w.launch.dynamic, r.launch.dynamic);
+        try std.testing.expectEqual(w.launch.opt_in, r.launch.opt_in);
+        try std.testing.expectEqual(w.launch.min_sm, r.launch.min_sm);
+        for (registry.usageFor(w, .{ .major = 13, .minor = 3 }), got) |a, b| {
+            try std.testing.expectEqual(a.static, b.static);
+            try std.testing.expectEqual(a.bound, b.bound);
+        }
+    }
+}
+
+test "GLM fused chunks: every fused launch is registered once, beside its window twin" {
+    var n: usize = 0;
+    for (registry.all_cuda) |r| {
+        if (std.mem.startsWith(u8, r.launch.symbol, "tf_glm_chunks_") and std.mem.endsWith(u8, r.launch.symbol, "_fused")) n += 1;
+    }
+    try std.testing.expectEqual(cuda.len, n);
+    for (cuda) |r| _ = try twin(r);
+}
