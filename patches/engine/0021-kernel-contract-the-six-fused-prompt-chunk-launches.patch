+    .{ .name = "glm_glue tf_glm_chunks_32_fused", .usage = .{ .{ .regs = 211, .static = 0, .bound = 256 }, .{ .regs = 211, .static = 0, .bound = 256 }, .{ .regs = 211, .static = 0, .bound = 256 }, .{ .regs = 251, .static = 0, .bound = 256 }, .{ .regs = 251, .static = 0, .bound = 256 } } },
+    .{ .name = "glm_glue tf_glm_chunks_32_fp8_fused", .usage = .{ .{ .regs = 255, .static = 0, .bound = 256 }, .{ .regs = 252, .static = 0, .bound = 256 }, .{ .regs = 255, .static = 0, .bound = 256 }, .{ .regs = 248, .static = 0, .bound = 256 }, .{ .regs = 248, .static = 0, .bound = 256 } } },
+    .{ .name = "glm_glue tf_glm_chunks_32_fp8_paged_fused", .usage = .{ .{ .regs = 255, .static = 0, .bound = 256 }, .{ .regs = 255, .static = 0, .bound = 256 }, .{ .regs = 253, .static = 0, .bound = 256 }, .{ .regs = 249, .static = 0, .bound = 256 }, .{ .regs = 249, .static = 0, .bound = 256 } } },
 };
