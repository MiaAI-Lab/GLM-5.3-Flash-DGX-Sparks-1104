From faf029eba4a3dfdfc60e1500dada4dff1b52bd36 Mon Sep 17 00:00:00 2001
From: GrgaPalcic <26028466+GrgaPalcic@users.noreply.github.com>
Date: Tue, 10 Nov 2026 10:30:55 +0100
Subject: [PATCH] glm cuda: the startup plan counts TF_KV_SHARE's kept states,
 a slot each beside the pool's pages

Ported from upstream 389769733 and fitted under TF_PROMPT_CACHE_FIRST: the kept states' slots (KDA state, rings, the DFlash2 ring) are set aside inside the plan, once, so the share costs no memory outside what the startup line reports.
---
 zig/src/core/kv_pool.zig               |   9 +-
 zig/src/core/kv_pool_test.zig          |  62 ++++++++++++++
 zig/src/families/glm/cuda_native.zig   |  37 +++++---
 zig/src/families/glm/cuda_pages.zig    |   5 ++
 zig/src/families/glm/cuda_share.zig    |  29 +++++--
 zig/src/native/cuda.zig                |  18 ++--
 zig/src/native/cuda_kv_pool.zig        | 113 ++++++++++++++++++++-----
 zig/src/native/cuda_kv_safety_test.zig |   2 +-
 8 files changed, 224 insertions(+), 51 deletions(-)

diff --git a/zig/src/core/kv_pool.zig b/zig/src/core/kv_pool.zig
index 8f3cf45b..1ec6db72 100644
--- a/zig/src/core/kv_pool.zig
+++ b/zig/src/core/kv_pool.zig
@@ -38,6 +38,11 @@ pub const Layout = struct {
 /// Slots a plan sets aside for snapshots when the caller names no count.
 pub const most_snaps = 64;
 
+/// The --prompt-cache-gib whose bytes hold `states` slots of `slot` bytes, rounded up to a whole GiB.
+pub fn holdingGib(states: usize, slot: u64) u64 {
+    return (states * slot + (1 << 30) - 1) >> 30;
+}
+
 /// What the room at load pays for, in order: the engine's own sequence, the other streams, the prompt cache.
 pub const Budget = struct {
     /// What the device grants past the weights.
@@ -58,6 +63,8 @@ pub const Budget = struct {
     engine_paged: bool = false,
     /// Parts per million of the cache that kept states hold as pool pages (TF_KV_SHARE): made pages past the windows.
     kept_ppm: u32 = 0,
+    /// TF_KV_SHARE with a slot a state (GLM): the cache is its slots, `snaps` at most, and the rest is made pages.
+    slots_only: bool = false,
     /// The cache is set aside before the room is counted in windows (TF_PROMPT_CACHE_FIRST=1): the other streams
     /// share the pages left, at least the engine's own window, instead of the cache taking what whole windows leave.
     cache_first: bool = false,
@@ -85,7 +92,7 @@ pub fn plan(l: Layout, b: Budget) error{ NoStream, TooMany }!Plan {
     if (fit < extra and b.fixed) return error.TooMany;
     left -= fit * l.fixed_bytes;
     const cache = @min(b.cache, left -| held(l, b, fit));
-    const kept = cache / 1_000_000 * b.kept_ppm + cache % 1_000_000 * b.kept_ppm / 1_000_000; // the cache's share as pages
+    const kept = if (b.slots_only) cache - split(cache, l.snap_bytes, b.snaps).snaps * l.snap_bytes else cache / 1_000_000 * b.kept_ppm + cache % 1_000_000 * b.kept_ppm / 1_000_000; // the cache's share as pages
     const c = split(cache - kept, l.snap_bytes, b.snaps);
     left -= c.snaps * l.snap_bytes + c.copied;
     const most: u64 = if (b.window > 0) (fit + @intFromBool(b.engine_paged)) * l.pages(b.window) + fit * l.runPages() + kept / l.pageBytes() else std.math.maxInt(u64);
diff --git a/zig/src/core/kv_pool_test.zig b/zig/src/core/kv_pool_test.zig
index d04485d0..db655c6d 100644
--- a/zig/src/core/kv_pool_test.zig
+++ b/zig/src/core/kv_pool_test.zig
@@ -460,3 +460,65 @@ test "a hold past the free pages asks the store to reclaim first, as a promise d
     for (ids) |id| p.release(id);
     try expect(p.idle());
 }
+
+test "TF_KV_SHARE's slots alone (GLM): the cache keeps the slots it holds, the named count at most, and the rest is pages" {
+    const g: u64 = 1 << 30;
+    const glm: kv.Layout = .{ .fixed_bytes = 180 * mib, .token_bytes = 13_056, .page_tokens = 512, .snap_bytes = 180 * mib };
+    const b: kv.Budget = .{ .room = 80 * g, .engine = 0, .lanes = 4, .cache = g, .snaps = 16, .window = 262_144 + 8, .engine_paged = true, .slots_only = true };
+    const p = try kv.plan(glm, b);
+    try expectEqual(@as(usize, 5), p.snaps); // a GiB holds five of the sixteen named
+    try expectEqual(@as(u64, 0), p.copied);
+    try expectEqual(g - 5 * 180 * mib, p.kept);
+    var two = b;
+    two.snaps = 2;
+    const q = try kv.plan(glm, two);
+    try expectEqual(@as(usize, 2), q.snaps);
+    try expectEqual(g - 2 * 180 * mib, q.kept);
+    var copies = two; // the split without the flag: the slots' rest stays copied rows
+    copies.slots_only = false;
+    const r = try kv.plan(glm, copies);
+    try expectEqual(@as(usize, 2), r.snaps);
+    try expectEqual(g - 2 * 180 * mib, r.copied);
+    try expectEqual(@as(u64, 0), r.kept);
+    try expect(q.pages > r.pages and q.pages > p.pages); // what the slots leave is pages, past the windows' bound
+    var many = b;
+    many.snaps = 100;
+    many.cache = 16 * g;
+    try expectEqual(@as(usize, kv.most_snaps), (try kv.plan(glm, many)).snaps);
+}
+
+test "TF_KV_SHARE's slots with the cache first (TF_PROMPT_CACHE_FIRST): the slots are set aside before the windows' room, the rest is pages" {
+    const g: u64 = 1 << 30;
+    const glm: kv.Layout = .{ .fixed_bytes = 180 * mib, .token_bytes = 13_056, .page_tokens = 512, .snap_bytes = 180 * mib };
+    const b: kv.Budget = .{ .room = 80 * g, .engine = 0, .lanes = 8, .cache = g, .snaps = 16, .window = 262_144 + 8, .engine_paged = true, .slots_only = true, .cache_first = true };
+    const p = try kv.plan(glm, b);
+    try expectEqual(@as(usize, 5), p.snaps); // a GiB holds five of the sixteen named
+    try expectEqual(@as(u64, 0), p.copied);
+    try expectEqual(g - 5 * 180 * mib, p.kept);
+    var unset = b; // TF_KV_SHARE unset: the plan is as before, the cache's rest copied rows and none of it pages
+    unset.slots_only = false;
+    const r = try kv.plan(glm, unset);
+    try expectEqual(p.snaps, r.snaps);
+    try expectEqual(g - 5 * 180 * mib, r.copied);
+    try expectEqual(@as(u64, 0), r.kept);
+    try expect(p.pages > r.pages); // what the slots leave is pages, past the windows' bound
+    var small = b; // a cache too small for one slot keeps none
+    small.cache = 100 * mib;
+    const s = try kv.plan(glm, small);
+    try expectEqual(@as(usize, 0), s.snaps);
+    try expectEqual(@as(u64, 0), s.copied);
+}
+
+test "TF_KV_SHARE's slots (share_kept_ppm 0): the slots and the pool's pages never overcommit the room, cache first or not" {
+    const g: u64 = 1 << 30;
+    const glm: kv.Layout = .{ .fixed_bytes = 180 * mib, .token_bytes = 13_056, .page_tokens = 512, .snap_bytes = 180 * mib };
+    const page = glm.pageBytes();
+    for ([_]bool{ false, true }) |first| { // TF_PROMPT_CACHE_FIRST unset and =1: the plan holds either way
+        const b: kv.Budget = .{ .room = 80 * g, .engine = 0, .lanes = 8, .cache = g, .snaps = 32, .window = 262_144 + 8, .engine_paged = true, .kept_ppm = 0, .slots_only = true, .cache_first = first };
+        const p = try kv.plan(glm, b);
+        try expect(p.snaps > 0 and p.snaps < 32); // the GiB's cache holds fewer than the named 32: clamped, not overcommitted
+        try expect(p.copied == 0 and p.kept == b.cache - p.snaps * glm.snap_bytes); // the cache's rest is the pool's pages
+        try expectEqual(b.cache, p.snaps * glm.snap_bytes + p.kept); // the whole cache is placed, the slots before the pages
+        try expect(p.snaps * glm.snap_bytes + (p.lanes - 1) * glm.fixed_bytes + p.pages * page <= b.room); // all of it takes the room
+    }
+}
diff --git a/zig/src/families/glm/cuda_native.zig b/zig/src/families/glm/cuda_native.zig
index 2c671daa..06810756 100644
--- a/zig/src/families/glm/cuda_native.zig
+++ b/zig/src/families/glm/cuda_native.zig
@@ -86,19 +86,17 @@ pub fn attach(p: *anyopaque, streams: u32, pages: usize) !void {
     try own.lanes.x.pool(streams + 1, pages, l.pageBytes());
     own.e.pages = try pages_mod.Pages.init(own.gpa, own.e, l, streams + 1, pages, true);
     if (own.e.kvCtx() != null) own.e.kv_ctx.counts = &own.e.pages.?.shard.?.parts.counts; // rank 0's counters
-    if (own.share > 0) try share(own, streams + 1);
-}
-
-/// TF_KV_SHARE: each rank's `own.share` snapshots, sized at the window's last mark (rings whole), for the store.
-fn share(own: *Owned, parallel: u32) !void {
-    const e = own.e;
-    e.share_pages = true;
-    // cc-defer: the snapshots take the room set aside for --prompt-cache-gib; from the plan once it plans them
-    const slot = e.stateBytes(e.capacity - e.capacity % snap_grid);
-    try readySnapshots(own, own.share * slot);
-    if (share_mod.fewStates(own.share, parallel)) std.log.warn(
-        "TF_KV_SHARE={d} keeps under 4 states a GLM stream at --parallel {d}: live streams evict each other's before a resume; set it to {d} or more",
-        .{ own.share, parallel, 4 * parallel },
+}
+
+/// TF_KV_SHARE: the plan's `snaps` slots on each rank, a state each at the window's last mark (the layout's slot).
+pub fn share_states(p: *anyopaque, snaps: usize, parallel: u32) !void {
+    const own: *Owned = @ptrCast(@alignCast(p));
+    if (own.share == 0) return;
+    const slot = (own.layout orelse return error.NoPages).snap_bytes;
+    if (snaps > 0) try readySnapshots(own, snaps * slot);
+    if (share_mod.advice(snaps, parallel, slot)) |want| std.log.warn(
+        "TF_KV_SHARE={d} keeps {d} states in the prompt cache's slots, under 4 a GLM stream at --parallel {d}: live streams evict each other's before a resume; {d} take TF_KV_SHARE={d} and --prompt-cache-gib {d}",
+        .{ own.share, snaps, parallel, want.states, want.states, want.gib },
     );
 }
 
@@ -207,6 +205,10 @@ pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: [
     set.kv8 = o.kv8;
     if (std.c.getenv("TF_GLM_KV_SHARE") != null) return error.GlmKvShareMoved; // before any rank opens
     const share_snaps = try kp.sharing();
+    if (share_mod.tooMany(share_snaps)) {
+        std.log.err("TF_KV_SHARE={d} asks more kept states than the {d} a startup plan holds: set {d} or fewer", .{ share_snaps, kv.most_snaps, kv.most_snaps });
+        return error.GlmShareTooMany;
+    }
     return startup.open(io, p, if (std.c.getenv("TF_KV_PAGES")) |v| std.mem.span(v) else null, set, cuda.tp_watch, StartArgs{ .gpa = gpa, .io = io, .ctx = ctx, .dir = dir, .o = o, .p = p, .roce_bytes = roce_bytes, .share = share_snaps }, openRank);
 }
 
@@ -358,6 +360,10 @@ fn finishRank(a: OpenArgs) !Loaded {
     own.lanes = .{ .x = .{ .e = own.e, .link = &own.link }, .whole = off("TF_GLM_PROMPT_STEPS"), .alone = off("TF_GLM_SHARED"), .mtp_confidence = o.mtp_confidence };
     const extra: u64 = (if (o.drafter != null) dflash.ring_bytes else 0) + if (own.e.images) |v| v.streamBytes() else @as(usize, 0);
     own.layout = if (set.pages) try pages_mod.layout(gpa, own.e, extra) else null;
+    if (own.share > 0) if (own.layout) |*l| { // TF_KV_SHARE: the plan counts each kept state's slot
+        own.e.share_pages = true;
+        l.snap_bytes = pages_mod.shareSlot(own.e);
+    };
     return .{
         .draft_kind = if (own.e.drafter != null) "DFlash2" else null,
         .backend = own.lanes.backend(),
@@ -508,6 +514,7 @@ pub fn explain(_: ?*anyopaque, err: anyerror) ?[]const u8 {
         error.BadKvShare => "TF_KV_SHARE: give how many states the prompt store over the KV pages keeps, or 0 or unset for off",
         error.GlmKvShareMoved => "TF_GLM_KV_SHARE is now TF_KV_SHARE, the prompt store every family on the KV pool shares: set that instead",
         error.GlmShareNeedsPages => "TF_KV_SHARE keeps prompts as KV pool pages: set TF_KV_PAGES=on as well",
+        error.GlmShareTooMany => std.fmt.comptimePrint("TF_KV_SHARE keeps at most {d} states, a slot each in the startup plan: set {d} or fewer", .{ kv.most_snaps, kv.most_snaps }),
         error.KvShareWithShard => "TF_KV_SHARE with TF_GLM_KV_SHARD=1 is not supported yet: set one",
         error.BadKvPages => "TF_KV_PAGES: give auto, on (or 1, all) or off (or 0)",
         error.PoolTooSmall => "this request's prompt and max_tokens need more KV pages than the whole pool holds, even with every other stream done: shorten the prompt or lower max_tokens",
@@ -534,6 +541,10 @@ test "a checkpoint refused for its format, at the entry or by the loader, is exp
     for ([_]anyerror{ error.NotModelOpt, error.UnsupportedQuant, error.UnreadableFormat, error.UnreadableExl3 }) |e| try std.testing.expect(explain(null, e) != null);
 }
 
+test "TF_KV_SHARE past the slots a startup plan holds is refused, and the refusal is explained" {
+    try std.testing.expect(share_mod.tooMany(kv.most_snaps + 1) and explain(null, error.GlmShareTooMany) != null);
+}
+
 test "TF_GLM_LEARN_STAGING_GIB: a refusal names the switch" {
     try std.testing.expect(explain(null, error.BadStagingGib) != null);
 }
diff --git a/zig/src/families/glm/cuda_pages.zig b/zig/src/families/glm/cuda_pages.zig
index 9636c2bd..2e7eb21e 100644
--- a/zig/src/families/glm/cuda_pages.zig
+++ b/zig/src/families/glm/cuda_pages.zig
@@ -29,6 +29,11 @@ pub fn layout(gpa: std.mem.Allocator, e: *const Engine, extra: u64) !kv.Layout {
     return .{ .fixed_bytes = fixed + extra, .token_bytes = token, .page_tokens = state.page_rows, .snap_bytes = 0 };
 }
 
+/// TF_KV_SHARE: a kept state's slot (`e.share_pages`: its prefix's pages left to the store), at the window's last mark.
+pub fn shareSlot(e: *const Engine) u64 {
+    return e.stateBytes(e.capacity - e.capacity % @import("cuda_native.zig").snap_grid);
+}
+
 /// The sharded page's parts for engine `e`: its DSA layers' latent rows and pooled keys (the MTP head is refused).
 pub fn geometry(e: *const Engine) kvs.Geometry {
     return kvs.Geometry.of(&e.w.config, state.mlaLayers(&e.w));
diff --git a/zig/src/families/glm/cuda_share.zig b/zig/src/families/glm/cuda_share.zig
index aea0be74..03032856 100644
--- a/zig/src/families/glm/cuda_share.zig
+++ b/zig/src/families/glm/cuda_share.zig
@@ -15,16 +15,29 @@ pub fn cacheable(s: *const Stream) bool {
     return s.prompt_logprobs == null and !s.untaught and s.embedding == null and cacheKey(s) != null;
 }
 
-/// Below 4 states a stream, live streams evict each other's before a resume reaches them.
-pub fn fewStates(states: usize, parallel: usize) bool {
-    return states > 0 and states < 4 * parallel;
+/// Below 4 states a stream, live streams evict each other's: that many, and the --prompt-cache-gib holding their slots.
+pub fn advice(states: usize, parallel: usize, slot: u64) ?struct { states: usize, gib: u64 } {
+    const want = 4 * parallel;
+    if (states >= want) return null;
+    return .{ .states = want, .gib = @import("core").kv_pool.holdingGib(want, slot) };
 }
 
-test "TF_KV_SHARE below 4 states a GLM stream is too few; off is not" {
-    try std.testing.expect(fewStates(4, 4));
-    try std.testing.expect(fewStates(15, 4));
-    try std.testing.expect(!fewStates(16, 4));
-    try std.testing.expect(!fewStates(0, 4));
+/// More kept states than a startup plan sets slots aside for (kv_pool.most_snaps): refused by name at start.
+pub fn tooMany(states: usize) bool {
+    return states > @import("core").kv_pool.most_snaps;
+}
+
+test "TF_KV_SHARE: under 4 planned states a GLM stream, the advice names 4 a stream and the cache their slots take" {
+    const mib: u64 = 1 << 20;
+    try std.testing.expect(advice(16, 4, 180 * mib) == null);
+    const a = advice(13, 4, 180 * mib).?; // a 2.4 GiB cache holds 13 of the 16 at --parallel 4
+    try std.testing.expectEqual(@as(usize, 16), a.states);
+    try std.testing.expectEqual(@as(u64, 3), a.gib); // 16 x 180 MiB is 2.8 GiB
+    try std.testing.expectEqual(@as(usize, 32), advice(0, 8, 180 * mib).?.states); // a cache holding none
+}
+
+test "TF_KV_SHARE: up to 64 states is a plan's, 65 is refused" {
+    try std.testing.expect(!tooMany(64) and tooMany(65) and !tooMany(0));
 }
 
 /// The store the server attached to rank 0's pages (null: none, or another rank).
