new file mode 100644
index 0000000..699d5ca
--- /dev/null
+++ b/zig/src/families/glm/cuda_snapshot_compact.zig
@@ -0,0 +1,77 @@
+//! Opt-in committed-state packing. Live layout and tensor precision stay unchanged.
+//! The caller must enforce pending==0 when saving. Restores must supply the SAVED cur.
+const std = @import("std");
+const State = @import("cuda_state.zig").State;
+const Config = @import("config.zig").Config;
+const layout = @import("cuda_snapshot_layout.zig");
+
+pub const Format = enum(u8) { legacy = 0, committed = 2, _ };
+
+pub fn selected() !Format {
+    const raw = std.c.getenv("TF_GLM_SNAPSHOT_FORMAT") orelse return .legacy;
+    const text = std.mem.span(raw);
+    if (std.mem.eql(u8, text, "legacy")) return .legacy;
+    if (std.mem.eql(u8, text, "committed")) return .committed;
+    return error.SnapshotFormat;
+}
+
+fn check(format: Format) !void {
+    switch (format) {
+        .legacy, .committed => {},
+        else => return error.SnapshotFormat,
+    }
+}
+
+const Header = struct { first: u64, rec_end: u64, bank: usize };
+
+fn header(st: *const State) !Header {
+    if (st.cur.len != st.kda_layers or st.rings.len != 2 * (st.caches.len + 1)) return error.SnapshotShape;
+    const first = if (st.table != 0) st.rings[0] else if (st.caches.len > 0) st.caches[0].lc else st.mtp_caches.lc;
+    const bank = try std.math.mul(usize, st.kda_layers, st.rec_layer);
+    const rec_end = try std.math.add(u64, st.rec, try std.math.mul(usize, bank, 2));
+    const arena_end = try std.math.add(u64, st.arena.buf.ptr, st.arena.buf.len);
+    if (st.rec < st.arena.buf.ptr or rec_end > st.proj or st.proj > first or first > arena_end) return error.SnapshotShape;
+    return .{ .first = first, .rec_end = rec_end, .bank = bank };
+}
+
+pub fn size(st: *const State, c: *const Config, capacity: usize, at: usize, head: ?usize, format: Format) !usize {
+    try check(format);
+    const n = try layout.Plan.size(st, c, capacity, at, head);
+    if (format == .legacy) return n;
+    const h = try header(st);
+    const skipped = try std.math.add(usize, h.bank, if (format == .committed) @intCast(h.first - st.proj) else 0);
+    return try std.math.sub(usize, n, skipped);
+}
+
+fn add(p: *layout.Plan, part: layout.Part) !void {
+    if (part.len == 0) return;
+    if (p.count == p.parts.len) return error.SnapshotShape;
+    p.len = try std.math.add(usize, p.len, part.len);
+    p.parts[p.count] = part;
+    p.count += 1;
+}
+
+pub fn plan(st: *const State, c: *const Config, at: usize, head: ?usize, format: Format, saved_cur: []const u1) !layout.Plan {
+    try check(format);
+    const original = try layout.Plan.init(st, c, at, head);
+    if (format == .legacy) return original;
+    const h = try header(st);
+    if (saved_cur.len != st.kda_layers or original.count == 0) return error.SnapshotShape;
+    const first = original.parts[0];
+    if (first.span != 0 or first.live != st.arena.buf.ptr or first.len != h.first - st.arena.buf.ptr) return error.SnapshotShape;
+    var p = original; // retain the owner's page tables and latent metadata
+    p.count = 0;
+    p.len = 0;
+    // Position, convolution and their original alignment precede both banks.
+    try add(&p, .{ .live = first.live, .len = @intCast(st.rec - first.live) });
+    for (saved_cur, 0..) |cur, li| try add(&p, .{ .live = st.recAt(cur, li), .len = st.rec_layer });
+    // Keep padding between the banks and projection, even when replay is omitted.
+    const tail_end = if (format == .committed) st.proj else h.first;
+    try add(&p, .{ .live = h.rec_end, .len = @intCast(tail_end - h.rec_end) });
+    // Latent codes/scales, DSA rings/pooled keys, MTP metadata and prompt hidden
+    // use the original owner's parts and page mapping, without reinterpretation.
+    for (original.parts[1..original.count]) |part| try add(&p, part);
+    const expected = try size(st, c, st.capacity, at, head, format);
+    if (p.len != expected) return error.SnapshotSize;
+    return p;
+}
