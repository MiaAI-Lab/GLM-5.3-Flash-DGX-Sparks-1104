--- /dev/null
+++ b/zig/glm_compact_snapshot_host.zig
@@ -0,0 +1,324 @@
+//! GLM kept-state sizing and transfers through the actual rank owner with a recording CUDA driver.
+const std = @import("std");
+const glm = @import("glm");
+const cuda = @import("cuda");
+const t = std.testing;
+
+const Sizing = struct {
+    var next: u64 = 1 << 30;
+    fn alloc(out: *u64, bytes: usize) callconv(.c) cuda.abi.Result {
+        out.* = next;
+        next += std.mem.alignForward(usize, bytes, 256);
+        return 0;
+    }
+    fn free(_: u64) callconv(.c) cuda.abi.Result {
+        return 0;
+    }
+    fn zero(_: u64, _: u8, _: usize) callconv(.c) cuda.abi.Result {
+        return 0;
+    }
+};
+
+const rec = @import("test_support/glm_snap_driver.zig").Driver;
+const Fixture = @import("test_support/glm_snap_fixture.zig").Fixture;
+const Settings = glm.ranks.Settings;
+const Fingerprint = glm.ranks.Fingerprint;
+const Mismatch = glm.ranks.Mismatch;
+const mismatch = glm.ranks.mismatch;
+
+fn rowAt(st: *const glm.forward.State, x: glm.dsa_block.Caches, base: u64, r: usize, width: usize, per: usize) u64 {
+    return if (x.pt == 0) base + r * width else base + @as(u64, st.pages[r / per]) * x.ps + (r % per) * width;
+}
+fn same(a: u64, b: u64, len: usize) !void {
+    try t.expectEqualSlices(u8, rec.bytes(a, len), rec.bytes(b, len));
+}
+// Committed snapshots through the actual owner and recording driver.
+const CompactProbe = struct {
+    const packing = glm.snapshots.compact;
+    const poison: u8 = 0xE9;
+
+    fn first(st: *const glm.forward.State) u64 {
+        return if (st.table != 0) st.rings[0] else st.caches[0].lc;
+    }
+
+    fn expectedOmissions(st: *const glm.forward.State, expected: []u8, format: packing.Format, parity: u1) void {
+        if (format == .legacy) return;
+        const inactive: usize = @intCast(st.recAt(1 - parity, 0) - st.arena.buf.ptr);
+        @memset(expected[inactive..][0..st.rec_layer], poison);
+        if (format == .committed) {
+            const off: usize = @intCast(st.proj - st.arena.buf.ptr);
+            @memset(expected[off..][0..@intCast(first(st) - st.proj)], poison);
+        }
+    }
+
+    fn omitted(st: *const glm.forward.State, format: packing.Format) !void {
+        if (format == .legacy) return;
+        for (st.cur, 0..) |cur, i| for (rec.bytes(st.recAt(1 - cur, i), st.rec_layer)) |b| try t.expectEqual(poison, b);
+        if (format == .committed) for (rec.bytes(st.proj, @intCast(first(st) - st.proj))) |b| try t.expectEqual(poison, b);
+    }
+
+    fn valid(c: glm.config.Config, a: *const glm.forward.State, b: *const glm.forward.State, at: usize) !void {
+        try t.expectEqualSlices(u1, a.cur, b.cur);
+        try same(a.pos_dev, b.pos_dev, 4);
+        try same(a.conv, b.conv, a.kda_layers * 3 * a.conv_c * 2);
+        for (a.cur, 0..) |cur, i| try same(a.recAt(cur, i), b.recAt(cur, i), a.rec_layer);
+        for (a.caches, b.caches, 0..) |x, y, j| {
+            for (0..at) |r| {
+                try same(rowAt(a, x, x.lc, r, c.kv_lora, 512), rowAt(b, y, y.lc, r, c.kv_lora, 512), c.kv_lora);
+                try same(rowAt(a, x, x.ls, r, 4, 512), rowAt(b, y, y.ls, r, 4, 512), 4);
+            }
+            for (0..2) |k| try same(a.rings[2 * j + k], b.rings[2 * j + k], @min(at, a.ring_rows) * a.ring_row);
+            for (0..@min(at / 4 + 2, x.pk_rows)) |r| try same(rowAt(a, x, x.pk, r, c.i_dim * 2, 128), rowAt(b, y, y.pk, r, c.i_dim * 2, 128), c.i_dim * 2);
+        }
+        try same(a.mtp_pos_dev, b.mtp_pos_dev, 4);
+        try same(a.prompt_hidden, b.prompt_hidden, c.hidden * 2);
+    }
+};
+
+test "GLM compact snapshots: owner roundtrip keeps valid fields and DFlash ring, leaves omissions poisoned" {
+    var d = rec.init();
+    for (0..2) |rank| {
+        var f: Fixture = undefined;
+        try f.initFormat(&d, rank, 2, false, true);
+        defer f.deinit();
+        var ring = try cuda.DeviceBuffer.alloc(&d, glm.dflash.ring_bytes);
+        defer ring.free();
+        var dr: glm.dflash.Drafter = undefined;
+        dr.gpa = t.allocator;
+        dr.d = &d;
+        dr.slots = .empty;
+        defer dr.slots.deinit(t.allocator);
+        try dr.slots.append(t.allocator, .{ .ring = ring });
+        f.e.drafter = &dr;
+        f.e.slot = 0;
+        // Force both device and host parts through the unchanged page-copy owner.
+        try f.e.prepareTiers(4 * glm.snapshots.pages.page, 2 * f.e.stateBytes(16384));
+        const spare = f.e.snap_pages.?.spare();
+        for ([_]CompactProbe.packing.Format{ .legacy, .committed }) |format| for ([_]usize{ 511, 4096, 16384 }) |at| for ([_]u1{ 0, 1 }) |parity| {
+            try f.mark(at, 0, @intCast(at % 251));
+            f.seq.st.cur[0] = parity;
+            dr.slots.items[0].from = @intCast(at -| 2048);
+            dr.slots.items[0].first = @intCast(at -| 2048);
+            dr.slots.items[0].end = @intCast(at);
+            dr.slots.items[0].v_rows = 7;
+            @memset(rec.bytes(ring.ptr, ring.len), 0x6D);
+            const st = &f.seq.st;
+            const expected = try t.allocator.dupe(u8, rec.bytes(st.arena.buf.ptr, st.arena.buf.len));
+            defer t.allocator.free(expected);
+            CompactProbe.expectedOmissions(st, expected, format, parity);
+            try glm.snapshots.keepAsFormat(&f.e, 1, format);
+            const saved = f.e.snaps.getPtr(1).?;
+            try t.expectEqual(@backingInt(format), saved.format);
+            try t.expect(saved.lease.host.ids.items.len > 0);
+            try t.expectEqual(try glm.snapshots.pages.rounded(saved.len), glm.snapshots.bytesFormat(&f.e, at, format));
+            @memset(rec.bytes(st.arena.buf.ptr, st.arena.buf.len), CompactProbe.poison);
+            @memset(rec.bytes(ring.ptr, ring.len), CompactProbe.poison);
+            st.cur[0] = 1 - parity; // restore must address saved parity, not this stale target parity.
+            try f.e.restoreState(1);
+            try f.expectPrefix(expected, at, 0);
+            try CompactProbe.omitted(st, format);
+            try t.expectEqual(parity, st.cur[0]);
+            try t.expectEqual(at, st.pos);
+            for (rec.bytes(ring.ptr, ring.len)) |b| try t.expectEqual(@as(u8, 0x6D), b);
+            try t.expectEqual(@as(i64, @intCast(at -| 2048)), dr.slots.items[0].from);
+            try t.expectEqual(@as(i64, @intCast(at)), dr.slots.items[0].end);
+            try t.expectEqual(@as(usize, 0), dr.slots.items[0].v_rows);
+            f.e.dropState(1);
+            f.e.dropped.clearRetainingCapacity();
+            try t.expectEqual(spare, f.e.snap_pages.?.spare());
+        };
+    }
+}
+
+test "GLM compact snapshots: FP8 paged and window owners exchange valid state with saved parity" {
+    var d = rec.init();
+    for (0..2) |rank| {
+        var f: Fixture = undefined;
+        try f.initFormat(&d, rank, 2, false, true);
+        defer f.deinit();
+        var w: glm.weights.Weights = undefined;
+        w.config = f.e.c;
+        w.share = f.e.share;
+        var layers: [2]glm.weights.Layer = undefined;
+        layers[0].mixer = .{ .mla = undefined };
+        layers[1].mixer = .{ .kda = undefined };
+        w.layers = &layers;
+        const page = glm.state.pageBytesOf(&w, true, false);
+        const ids = [_]u32{ 5, 2, 9, 0, 7, 1, 3, 8, 4, 6 };
+        var kv = try cuda.DeviceBuffer.alloc(&d, ids.len * page);
+        defer kv.free();
+        var paged = f.seq;
+        paged.st = try glm.forward.State.initPagedFormat(t.allocator, &d, &w, 16448, .{ .kv = kv.ptr, .pages = glm.pages.tableLen(16448), .page_bytes = page }, true, false);
+        defer paged.st.deinit();
+        paged.st.pages = &ids;
+        paged.st.capacity = ids.len * 512;
+        const window = &f.seq;
+        try f.e.prepareSnapshots(3 * f.e.stateBytes(4096));
+        for ([_]CompactProbe.packing.Format{.committed}) |format| for ([_]usize{ 511, 1537, 4096 }) |at| for ([_]u1{ 0, 1 }) |parity| {
+            f.e.cur = window;
+            try f.mark(at, 0, 17);
+            window.st.cur[0] = parity;
+            try glm.snapshots.keepAsFormat(&f.e, 1, format);
+            @memset(rec.bytes(paged.st.arena.buf.ptr, paged.st.arena.buf.len), CompactProbe.poison);
+            @memset(rec.bytes(kv.ptr, kv.len), CompactProbe.poison);
+            paged.st.cur[0] = 1 - parity;
+            f.e.cur = &paged;
+            try f.e.restoreState(1);
+            try CompactProbe.valid(f.e.c, &window.st, &paged.st, at);
+            try CompactProbe.omitted(&paged.st, format);
+            for (rec.bytes(paged.st.table, ids.len * 4)) |b| try t.expectEqual(CompactProbe.poison, b);
+            f.e.dropState(1);
+            f.e.dropped.clearRetainingCapacity();
+            try glm.snapshots.keepAsFormat(&f.e, 2, format);
+            @memset(rec.bytes(window.st.arena.buf.ptr, window.st.arena.buf.len), CompactProbe.poison);
+            window.st.cur[0] = 1 - parity;
+            f.e.cur = window;
+            try f.e.restoreState(2);
+            try CompactProbe.valid(f.e.c, &paged.st, &window.st, at);
+            try CompactProbe.omitted(&window.st, format);
+            f.e.dropState(2);
+            f.e.dropped.clearRetainingCapacity();
+        };
+        f.e.cur = window;
+    }
+}
+
+test "GLM compact snapshots: unknown format, pending state and failed copies do not publish" {
+    var d = rec.init();
+    var f: Fixture = undefined;
+    try f.initFormat(&d, 0, 2, false, true);
+    defer f.deinit();
+    try f.mark(4096, 0, 31);
+    try f.e.prepareSnapshots(2 * f.e.stateBytes(4096));
+    const spare = f.e.snap_pages.?.spare();
+    try t.expectError(error.SnapshotFormat, glm.snapshots.keepAsFormat(&f.e, 1, @fromBackingInt(@intCast(254))));
+    try t.expectError(error.SnapshotShape, CompactProbe.packing.plan(&f.seq.st, &f.e.c, 4096, null, .committed, &.{}));
+    f.seq.st.pending = 1;
+    try t.expectError(error.NotAtMark, glm.snapshots.keepAsFormat(&f.e, 1, .committed));
+    f.seq.st.pending = 0;
+    rec.fail_copy = rec.copies + 2;
+    try t.expectError(error.NotReady, glm.snapshots.keepAsFormat(&f.e, 1, .committed));
+    rec.fail_copy = null;
+    try t.expectEqual(@as(u32, 0), f.e.snaps.count());
+    try t.expectEqual(spare, f.e.snap_pages.?.spare());
+    try glm.snapshots.keepAsFormat(&f.e, 1, .committed);
+    const saved = f.e.snaps.getPtr(1).?;
+    saved.format = 254;
+    const copies = rec.copies;
+    try t.expectError(error.SnapshotFormat, f.e.restoreState(1));
+    try t.expectEqual(copies, rec.copies);
+    saved.format = @backingInt(CompactProbe.packing.Format.committed);
+    f.e.dropState(1);
+    f.e.dropped.clearRetainingCapacity();
+    try t.expectEqual(spare, f.e.snap_pages.?.spare());
+}
+
+test "GLM compact snapshots: full TP2 shape prices and mixed layer parity match original sizing" {
+    var d: cuda.Driver = undefined;
+    d.api.cuMemAlloc_v2 = Sizing.alloc;
+    d.api.cuMemFree_v2 = Sizing.free;
+    d.api.cuMemsetD8_v2 = Sizing.zero;
+    var w: glm.weights.Weights = undefined;
+    w.config = .{};
+    var layers: [glm.config.max_layers]glm.weights.Layer = undefined;
+    w.layers = layers[0..w.config.layers];
+    for (w.layers, 0..) |*layer, i| layer.mixer = switch (w.config.kind(@intCast(i))) {
+        .mla => .{ .mla = undefined },
+        .kda => .{ .kda = undefined },
+    };
+    const capacity = glm.native.capacity(1048576);
+    const ids = try t.allocator.alloc(u32, glm.pages.tableLen(capacity));
+    defer t.allocator.free(ids);
+    for (ids, 0..) |*id, i| id.* = @intCast(ids.len - 1 - i);
+    for (0..2) |rank| {
+        w.share = try glm.shard.Share.of(&w.config, rank, 2);
+        for ([_]bool{ false, true }) |paged| {
+            var st = if (paged)
+                try glm.forward.State.initPagedFormat(t.allocator, &d, &w, capacity, .{ .kv = 1 << 55, .pages = glm.pages.tableLen(capacity), .page_bytes = glm.state.pageBytesOf(&w, true, false) }, true, false)
+            else
+                try glm.forward.State.initHead(t.allocator, &d, &w, capacity, true, false);
+            defer st.deinit();
+            if (paged) {
+                // initPagedFormat starts with capacity=0 until pages are mapped.
+                st.pages = ids;
+                st.capacity = capacity;
+            }
+            const saved = try t.allocator.alloc(u1, st.kda_layers);
+            defer t.allocator.free(saved);
+            for (saved, st.cur, 0..) |*s, *cur, i| {
+                s.* = @truncate(i);
+                cur.* = 1 - s.*;
+            }
+            const bank = st.kda_layers * st.rec_layer;
+            try t.expectEqual(@as(usize, 68 << 20), bank);
+            for ([_]usize{ 8192, 32768, 131072 }) |at| for ([_]CompactProbe.packing.Format{.committed}) |format| {
+                const p = try CompactProbe.packing.plan(&st, &w.config, at, null, format, saved);
+                const original = try glm.snapshots.layout.Plan.size(&st, &w.config, capacity, at, null);
+                const scratch: usize = if (format == .committed) @intCast(CompactProbe.first(&st) - st.proj) else 0;
+                try t.expectEqual(original - bank - scratch, p.len);
+                for (saved, 0..) |parity, i| try t.expectEqual(st.rec + (@as(usize, parity) * st.kda_layers + i) * st.rec_layer, p.parts[i + 1].live);
+            };
+        }
+    }
+}
+
+test "GLM compact snapshots: configured owner and disk entry points refuse incompatible payloads" {
+    var d = rec.init();
+    var f: Fixture = undefined;
+    try f.initFormat(&d, 0, 2, false, true);
+    defer f.deinit();
+    try f.mark(4096, 0, 31);
+    try f.e.prepareSnapshots(2 * f.e.stateBytes(4096));
+    const spare = f.e.snap_pages.?.spare();
+    f.e.settings.snapshot_committed = true;
+    try t.expectError(error.SnapshotDiskFormat, f.e.blankAs(1, 4096, null));
+    try t.expectError(error.SnapshotDiskFormat, glm.disk_ranks.shape(&f.e));
+    f.e.settings.kv_shard.on = true;
+    try t.expectError(error.SnapshotConfiguration, f.e.keepAs(1));
+    f.e.settings.kv_shard.on = false;
+    try t.expectEqual(spare, f.e.snap_pages.?.spare());
+    try f.e.keepAs(1);
+    try t.expectEqual(@as(u8, 2), f.e.snaps.get(1).?.format);
+    // Even an in-process settings change cannot serialize a compact lease as legacy disk bytes.
+    f.e.settings.snapshot_committed = false;
+    try t.expectError(error.SnapshotDiskFormat, glm.disk_ranks.wordsOf(&f.e, 1));
+    var out: [32]u8 = undefined;
+    try t.expectError(error.SnapshotDiskFormat, glm.disk_ranks.copy(&f.e, 1, 0, &out, true));
+    try f.e.restoreState(1); // the saved format, not the current setting, chooses the plan
+}
+
+test "TF_GLM_SNAPSHOT_FORMAT: defaults, parsing, sharding refusal and rank agreement" {
+    const Reader = struct {
+        fn absent(_: [:0]const u8) ?[]const u8 {
+            return null;
+        }
+        fn on(key: [:0]const u8) ?[]const u8 {
+            return if (std.mem.eql(u8, key, "TF_GLM_SNAPSHOT_FORMAT")) "committed" else null;
+        }
+        fn legacy(key: [:0]const u8) ?[]const u8 {
+            return if (std.mem.eql(u8, key, "TF_GLM_SNAPSHOT_FORMAT")) "legacy" else null;
+        }
+        fn bad(key: [:0]const u8) ?[]const u8 {
+            return if (std.mem.eql(u8, key, "TF_GLM_SNAPSHOT_FORMAT")) "comitted" else null;
+        }
+        fn sharded(key: [:0]const u8) ?[]const u8 {
+            return if (std.mem.eql(u8, key, "TF_GLM_KV_SHARD")) "1" else on(key);
+        }
+    };
+    var problem: []const u8 = "";
+    try std.testing.expect(!(try Settings.read(Reader.absent, &problem)).snapshot_committed);
+    try std.testing.expect(!(try Settings.read(Reader.legacy, &problem)).snapshot_committed);
+    const on = try Settings.read(Reader.on, &problem);
+    try std.testing.expect(on.snapshot_committed);
+    try std.testing.expectError(error.BadSetting, Settings.read(Reader.bad, &problem));
+    try std.testing.expectEqualStrings("TF_GLM_SNAPSHOT_FORMAT: legacy or committed", problem);
+    try std.testing.expectError(error.BadSetting, Settings.read(Reader.sharded, &problem));
+    try std.testing.expectEqualStrings("TF_GLM_SNAPSHOT_FORMAT=committed requires TF_GLM_KV_SHARD=0", problem);
+    var all = [_]Fingerprint{
+        Fingerprint.of(2, 0, .{}, 8192, true, @splat(0), @splat(0), @splat(0)),
