From ba6201acac60b37ea213537d29eea0de1d63a67e Mon Sep 17 00:00:00 2001
From: GrgaPalcic <26028466+GrgaPalcic@users.noreply.github.com>
Date: Tue, 10 Nov 2026 10:30:55 +0100
Subject: [PATCH] tests: glm host tests follow patch 0094's 4,096-row chunk
 grid, facts' e.drafts (0014) and the MM_STAGES note

At f350cd3e + 0001-0112 these host targets failed before any change of this series: test-glm-snapshots-host 4/26 (0094 changed stateBytes and snap_grid sizes), test-glm-prompts-host 1/7 (0095 raised dflash.MAX_CTX), test-cuda-host draft_sources_cuda_test and glm_fp8_pages_host. The tests are re-sized to the recipe's grid; no engine code changes. From here on every host target is green.
---
 zig/glm_fp8_pages_host.zig                 | 21 ++++++-------
 zig/glm_snapshot_host.zig                  | 34 ++++++++++++----------
 zig/src/families/glm/cuda_mm.zig           |  3 +-
 zig/src/native/draft_sources_cuda_test.zig |  4 ++-
 4 files changed, 34 insertions(+), 28 deletions(-)

diff --git a/zig/glm_fp8_pages_host.zig b/zig/glm_fp8_pages_host.zig
index eb5edf55..c71de1ae 100644
--- a/zig/glm_fp8_pages_host.zig
+++ b/zig/glm_fp8_pages_host.zig
@@ -724,9 +724,10 @@ test "GLM FP8 pages: the prompt cache's store keeps paged E4M3 states past the c
             try e.prepareTiers(budget, host);
         }
     };
-    const ids_a = [_]u32{ 2, 0, 3, 1, 8 }; // 2,048 rows and a page past them
-    const ids_b = [_]u32{ 6, 4, 7, 5, 9 };
-    var kv_buf = try cuda.DeviceBuffer.alloc(&d, 10 * page);
+    // 4,096 rows (the chunk grid) and a page past them
+    const ids_a = [_]u32{ 2, 0, 3, 1, 8, 10, 11, 12, 13 };
+    const ids_b = [_]u32{ 6, 4, 7, 5, 9, 14, 15, 16, 17 };
+    var kv_buf = try cuda.DeviceBuffer.alloc(&d, 20 * page);
     defer kv_buf.free();
     var a = f.seq;
     a.st = try paged8(&d, &f, kv_buf.ptr, &ids_a, false);
@@ -736,7 +737,7 @@ test "GLM FP8 pages: the prompt cache's store keeps paged E4M3 states past the c
     defer b.st.deinit();
     f.e.cur = &a;
     defer f.e.cur = &f.seq;
-    const one = f.e.stateBytes(2048);
+    const one = f.e.stateBytes(glm.native.snap_grid);
     Ready.host = 3 * one;
     f.e.snap_setup = .{ .ptr = &f.e, .run = Ready.run };
     const budget = try adapter.cacheBudget(glm.native, &f.e, one + 31);
@@ -744,18 +745,18 @@ test "GLM FP8 pages: the prompt cache's store keeps paged E4M3 states past the c
     const family: pc.Snapshots = .{ .ptr = &f.e, .vtable = &adapter.Snaps(glm.native, null).vtable };
     var store = pc.Store.init(t.allocator, family, adapter.cacheRules(glm.native), budget);
     defer store.deinit();
-    var prompt: [2049]u32 = @splat(1);
+    var prompt: [glm.native.snap_grid + 1]u32 = @splat(1);
     for (0..7) |i| {
         prompt[0] = @intCast(i);
-        try markPaged(&f, &a.st, kv_buf.ptr, page, 2048, 0, @intCast(i));
-        try t.expect(store.keep(&prompt, 2048, null, &.{}, &.{}));
+        try markPaged(&f, &a.st, kv_buf.ptr, page, glm.native.snap_grid, 0, @intCast(i));
+        try t.expect(store.keep(&prompt, glm.native.snap_grid, null, &.{}, &.{}));
         try t.expect(store.entries.items.len <= 4);
     }
     try t.expectEqual(@as(usize, 4), store.entries.items.len); // one on the card, three in host memory
     try t.expectEqual(@as(u64, 3), store.counts.evicted);
     // the last kept (salt 6) resumes onto b's pages as a's pages held it
     prompt[0] = 6;
-    const found = try store.lookup(t.allocator, &prompt, 2048, &.{}, &.{}, &.{});
+    const found = try store.lookup(t.allocator, &prompt, glm.native.snap_grid, &.{}, &.{}, &.{});
     defer t.allocator.free(found.marks);
     const e = found.entry orelse return error.ExpectedHit;
     defer store.release(e);
@@ -763,9 +764,9 @@ test "GLM FP8 pages: the prompt cache's store keeps paged E4M3 states past the c
     clobber(&b.st, kv_buf.ptr, page, 0xFF);
     f.e.cur = &b;
     try f.e.restoreState(kept.id);
-    try samePrefix8(c, &a.st, &b.st, 2048, null);
+    try samePrefix8(c, &a.st, &b.st, glm.native.snap_grid, null);
     prompt[0] = 0; // the oldest went first
-    const gone = try store.lookup(t.allocator, &prompt, 2048, &.{}, &.{}, &.{});
+    const gone = try store.lookup(t.allocator, &prompt, glm.native.snap_grid, &.{}, &.{}, &.{});
     defer t.allocator.free(gone.marks);
     try t.expect(gone.entry == null);
 }
diff --git a/zig/glm_snapshot_host.zig b/zig/glm_snapshot_host.zig
index f4ff6cdc..db6c8dc7 100644
--- a/zig/glm_snapshot_host.zig
+++ b/zig/glm_snapshot_host.zig
@@ -48,7 +48,7 @@ test "GLM snapshots: a short prefix fits 4 GiB even with a 524288-token configur
     for ([_]u32{ 2048, 34816, 266240 }) |at| {
         std.debug.print("GLM snapshot sizing rank=0 world=2 at={d} bytes={d} arena={d}\n", .{ at, glm.native.snap_bytes(&e, at), seq.st.arena.buf.len });
     }
-    const short = glm.native.snap_bytes(&e, 2048);
+    const short = glm.native.snap_bytes(&e, 4096); // the first chunk's mark: 4,096 rows here (recipe 0094)
     try t.expectEqual(short, glm.native.snap_min_bytes(&e));
     const longer = glm.native.snap_bytes(&e, 34816);
     try t.expect(short < 4 * @as(u64, 1 << 30));
@@ -115,23 +115,24 @@ test "GLM snapshots: actual store charges held plus spare pages, evicts and prot
     var f: Fixture = undefined;
     try f.init(&d, 0, 1, false);
     defer f.deinit();
-    const budget = 2 * f.e.stateBytes(2048) + 31;
+    const grid = glm.native.snap_grid; // keeps and lookups sit on the family's chunk grid (4,096 rows here)
+    const budget = 2 * f.e.stateBytes(grid) + 31;
     _ = try glm.native.snap_ready(&f.e, budget);
     const family: pc.Snapshots = .{ .ptr = &f.e, .vtable = &adapter.Snaps(glm.native, null).vtable };
     var store = pc.Store.init(t.allocator, family, adapter.cacheRules(glm.native), budget);
     defer store.deinit();
     const allocs = rec.allocs;
-    var prompt: [2049]u32 = @splat(1);
+    var prompt: [grid + 1]u32 = @splat(1);
     for (0..9) |i| {
         prompt[0] = @intCast(i);
-        try f.mark(2048, 2048, @intCast(i));
-        try t.expect(store.keep(&prompt, 2048, null, &.{}, &.{}));
+        try f.mark(grid, grid, @intCast(i));
+        try t.expect(store.keep(&prompt, grid, null, &.{}, &.{}));
         try t.expect(store.held + glm.native.snap_spare(&f.e) <= budget);
         try t.expectEqual(allocs, rec.allocs);
         try t.expect(store.entries.items.len <= 2);
     }
     try t.expect(store.counts.evicted > 0);
-    const found = try store.lookup(t.allocator, &prompt, 2048, &.{}, &.{}, &.{});
+    const found = try store.lookup(t.allocator, &prompt, grid, &.{}, &.{}, &.{});
     defer t.allocator.free(found.marks);
     const borrowed = found.entry orelse return error.ExpectedHit;
     defer store.release(borrowed);
@@ -139,8 +140,8 @@ test "GLM snapshots: actual store charges held plus spare pages, evicts and prot
     const id = kept.id;
     for (10..15) |i| {
         prompt[0] = @intCast(i);
-        try f.mark(2048, 2048, @intCast(i));
-        try t.expect(store.keep(&prompt, 2048, null, &.{}, &.{}));
+        try f.mark(grid, grid, @intCast(i));
+        try t.expect(store.keep(&prompt, grid, null, &.{}, &.{}));
         try t.expect(f.e.holds(id));
         try t.expect(store.held + glm.native.snap_spare(&f.e) <= budget);
     }
@@ -448,8 +449,9 @@ test "GLM snapshots: 0.3 GiB fits the first default TP2 prefix at 256K but not a
     e.capacity = seq.st.capacity;
     const minimum = glm.native.snap_min_bytes(&e);
     const budget: u64 = 322122547;
-    // 203,423,744 at 8-row windows; W16's 16-row windows double the KDA layers' window saves a state carries (+18 MiB)
-    try t.expectEqual(@as(u64, if (glm.forward.window_rows == 16) 222298112 else 203423744), minimum);
+    // 203,423,744 at 8-row windows on the 2,048 grid; W16's 16-row windows double the KDA layers' window saves
+    // (+18 MiB) and the 4,096-row chunk grid (recipe 0094) adds the extra 2,048 rows' caches (+36 MiB)
+    try t.expectEqual(@as(u64, if (glm.forward.window_rows == 16) 260046848 else 203423744), minimum);
     try t.expect(minimum <= budget);
     try t.expect(glm.native.snap_bytes(&e, 34816) > budget);
 }
@@ -708,7 +710,7 @@ test "GLM snapshots: the actual store's budget spans the host tier, keeps past t
     var f: Fixture = undefined;
     try f.init(&d, 0, 1, false);
     defer f.deinit();
-    const one = f.e.stateBytes(2048);
+    const one = f.e.stateBytes(glm.native.snap_grid);
     const Ready = struct {
         var host: u64 = 0;
         fn run(p: *anyopaque, budget: u64) anyerror!void {
@@ -723,11 +725,11 @@ test "GLM snapshots: the actual store's budget spans the host tier, keeps past t
     const family: pc.Snapshots = .{ .ptr = &f.e, .vtable = &adapter.Snaps(glm.native, null).vtable };
     var store = pc.Store.init(t.allocator, family, adapter.cacheRules(glm.native), budget);
     defer store.deinit();
-    var prompt: [2049]u32 = @splat(1);
+    var prompt: [glm.native.snap_grid + 1]u32 = @splat(1);
     for (0..9) |i| {
         prompt[0] = @intCast(i);
-        try f.mark(2048, 0, @intCast(i));
-        try t.expect(store.keep(&prompt, 2048, null, &.{}, &.{}));
+        try f.mark(glm.native.snap_grid, 0, @intCast(i));
+        try t.expect(store.keep(&prompt, glm.native.snap_grid, null, &.{}, &.{}));
         try t.expectEqual(budget - 31, store.held + glm.native.snap_spare(&f.e)); // whole pages: every one held or spare
         try t.expect(store.entries.items.len <= 4);
     }
@@ -737,13 +739,13 @@ test "GLM snapshots: the actual store's budget spans the host tier, keeps past t
     // the oldest kept is the first to go: the newest four still resume their own rows
     for (5..9) |i| {
         prompt[0] = @intCast(i);
-        const found = try store.lookup(t.allocator, &prompt, 2048, &.{}, &.{}, &.{});
+        const found = try store.lookup(t.allocator, &prompt, glm.native.snap_grid, &.{}, &.{}, &.{});
         defer t.allocator.free(found.marks);
         const e = found.entry orelse return error.ExpectedHit;
         defer store.release(e);
         const kept: *glm.engine.Kept = @ptrCast(@alignCast(e.saved));
         try f.e.restoreState(kept.id);
-        try t.expectEqual(@as(usize, 2048), f.seq.st.pos);
+        try t.expectEqual(@as(usize, glm.native.snap_grid), f.seq.st.pos);
     }
 }
 
diff --git a/zig/src/families/glm/cuda_mm.zig b/zig/src/families/glm/cuda_mm.zig
index 747d788d..3da1492c 100644
--- a/zig/src/families/glm/cuda_mm.zig
+++ b/zig/src/families/glm/cuda_mm.zig
@@ -257,7 +257,8 @@ pub const default_stage_index = 2; // 6 stages
 pub fn stageIndex(v: ?[]const u8) usize {
     const t = v orelse return default_stage_index;
     for (stage_variants, 0..) |st, i| if (t.len == 1 and t[0] == '0' + @as(u8, @intCast(st))) return i;
-    if (t.len != 0) std.log.err("TF_GLM_MM_STAGES: 3, 5, 6 or 8 (not '{s}'): {d}", .{ t, stage_variants[default_stage_index] });
+    // warn, not err: a mistyped knob falls back to the default, and the tests' runner fails any run that logs an error
+    if (t.len != 0) std.log.warn("TF_GLM_MM_STAGES: 3, 5, 6 or 8 (not '{s}'): {d}", .{ t, stage_variants[default_stage_index] });
     return default_stage_index;
 }
 
diff --git a/zig/src/native/draft_sources_cuda_test.zig b/zig/src/native/draft_sources_cuda_test.zig
index e1595d47..61a62640 100644
--- a/zig/src/native/draft_sources_cuda_test.zig
+++ b/zig/src/native/draft_sources_cuda_test.zig
@@ -36,8 +36,10 @@ test "draft sources: CUDA GLM distinguishes its checkpoint head from loaded DFla
     b.mtp_confidence = null;
     e.mtp = false;
     e.drafter = null;
+    e.drafts = false;
     try check(b.facts(), null, false, false);
-    e.mtp = true;
+    e.mtp = true; // the checkpoint head: speculation on (cuda_engine.heads, facts reads e.drafts since recipe 0014)
+    e.drafts = true;
     try check(b.facts(), null, true, true);
     b.mtp_confidence = 0.3; // --mtp-confidence: the head's chances size its windows, still a checkpoint head
     try check(b.facts(), null, true, true);
