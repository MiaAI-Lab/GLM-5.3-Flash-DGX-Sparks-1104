@@ -255,6 +259,18 @@ pub const Store = struct {
                 t.touch(last.?);
                 return .{ .held = true, .shared = mine.len };
             }
+            if (s.parts) |g| { // TF_GLM_KV_SHARD: a kept state's path never spans the parts
+                @memcpy(path[got..], mine[got..]); // the pages the tree lacks: the path's tail
+                if (!g.one(g.ctx, path[0..mine.len])) {
+                    if (got < mine.len) if (last) |n| if (t.alone(n)) {
+                        t.dropChain(n); // the older prefix chain goes: the new state is longer and replaces it whole
+                        continue;
+                    };
+                    g.refused(g.ctx);
+                    std.log.debug("kv shard: keeping {d} tokens refused: the kept pages and the new ones would span two parts (TF_GLM_KV_SHARD)", .{at});
+                    return .{ .held = false, .shared = got };
+                }
+            }
             if (t.held_pages + (mine.len - got) <= s.limits.pages and t.snaps + 1 <= s.limits.snaps) break;
             const v = s.victim(prompt, null) orelse {
                 t.counts.refused += 1;
@@ -282,8 +298,18 @@ pub const Store = struct {
     fn writeBehind(s: *Store, r: *rows.Rows, node: *Node, saved: pc.Saved) void {
         const t = &s.tree;
         const e = &node.entry.?;
-        const pages = t.gpa.dupe(u32, node.pages) catch return;
+        // the state's pages from its first token: every node's on the path to this one, in token order
+        var count: usize = 0;
+        var up: ?*Node = node;
+        while (up) |x| : (up = x.parent) count += x.pages.len;
+        const pages = t.gpa.alloc(u32, count) catch return;
         errdefer t.gpa.free(pages);
+        var at = count;
+        up = node;
+        while (up) |x| : (up = x.parent) {
+            at -= x.pages.len;
+            @memcpy(pages[at..][0..x.pages.len], x.pages);
+        }
         const tokens = t.gpa.dupe(u32, e.last[0..@min(e.last.len, node.end + t.ahead)]) catch return;
         errdefer t.gpa.free(tokens);
         for (pages) |id| t.pages.vtable.retain(t.pages.ptr, id);
