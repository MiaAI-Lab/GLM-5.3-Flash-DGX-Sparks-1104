diff --git a/zig/src/families/glm/cuda_kv_shard_pages_test.zig b/zig/src/families/glm/cuda_kv_shard_pages_test.zig
index 38940ef9..63283efc 100644
--- a/zig/src/families/glm/cuda_kv_shard_pages_test.zig
+++ b/zig/src/families/glm/cuda_kv_shard_pages_test.zig
@@ -1120,3 +1120,57 @@ test "kv shard pages: a hand-built cross-part kept state is not adopted by begin
     try expectEqual(@as(usize, 0), adopt2.items.len);
     try expect(owner2.pending == null);
 }
+
+test "kv shard pages: a kept state whose home is not its adopted pages' part is not resumed by begin, it is evicted" {
+    const gpa = std.testing.allocator;
+    const lanes = @import("lanes");
+    const kv = @import("core").kv_pool;
+    for ([_]u8{ 1, 0 }) |home| { // its pages lie in part 1: home 1 resumes, home 0 (a recall filed apart) does not
+        var f: Fake = undefined;
+        Fake.reset();
+        try f.init(gpa, 0, true);
+        f.e.snaps = .empty;
+        defer f.e.snaps.deinit(gpa);
+        const p = try f.pool(4, 20, true); // two parts of 8
+        defer f.deinit(p);
+        const x = p.shard.?;
+        var st: Stored = undefined;
+        try st.open(gpa, &f.e, 8);
+        defer st.close(&f.e);
+        const prompt = try gpa.alloc(u32, 4097);
+        defer gpa.free(prompt);
+        for (prompt, 1..) |*t, i| t.* = @intCast(i);
+
+        var b: kv.Lease = .{};
+        try x.parts.pools[1].promise(&b, 8);
+        try x.parts.pools[1].cover(&b, 8, null);
+        var mine: [8]u32 = undefined;
+        for (b.ids.items, 0..) |id, i| mine[i] = id + 8; // part 1's
+        var path: [8]u32 = undefined;
+        var owner: share_mod.Owner = .{};
+        try expect(st.store.keep(prompt, 4096, &owner, &mine, &path).held);
+        x.parts.pools[1].finish(&b);
+        try f.e.snaps.put(gpa, st.next - 1, .{ .lease = .{}, .len = 0, .pos = 4096, .mtp_len = 0, .cur = &.{}, .bases = .{ 0, 0 }, .home = home });
+
+        var s: lanes.Stream = undefined;
+        s.reuse = .{};
+        s.key = prompt;
+        s.prompt_len = prompt.len;
+        s.history_len = 0;
+        s.shared_prefixes = &.{};
+        var adopt: std.ArrayList(u32) = .empty;
+        defer adopt.deinit(gpa);
+        const plan = try share_mod.begin(&f.e, &s, &owner, &adopt);
+        defer f.e.gpa.free(plan.marks);
+        if (home == 1) {
+            try expectEqual(@as(usize, 8), adopt.items.len);
+            try expect(owner.pending != null);
+            for (adopt.items) |id| x.parts.release(id); // the begin's holds go back
+        } else {
+            try expectEqual(@as(usize, 0), adopt.items.len);
+            try expect(owner.pending == null);
+            for (mine) |id| try expectEqual(@as(u32, 0), x.parts.holders(id)); // evicted: the tree's holds went
+            try expectEqual(@as(usize, 0), st.live);
+        }
+    }
+}
diff --git a/zig/src/families/glm/cuda_share.zig b/zig/src/families/glm/cuda_share.zig
index 73ea03d7..c316f157 100644
--- a/zig/src/families/glm/cuda_share.zig
+++ b/zig/src/families/glm/cuda_share.zig
@@ -66,6 +66,15 @@ pub fn begin(e: *engine.Engine, s: *const Stream, owner: *Owner, adopt: *std.Arr
         prompts.forget(key, plan.from); // the mixed state goes: a later pass runs cold
         std.log.warn("kv shard: a kept state at {d} tokens holds {d} pages in both parts (TF_GLM_KV_SHARD); it is evicted, the pass runs cold", .{ plan.from, n });
     };
+    // a state whose home is not its adopted pages' part (a disk recall filed apart from the prefix the tree held):
+    // its resume would carry latent rows the pages already hold, and the ranks cut that carry apart
+    if (e.pages) |p| if (p.shard) |x| if (adopt.items.len > 0) if (owner.pending) |k| if (homeOf(e, k.id)) |home| if (home != p.partOf(adopt.items[0])) {
+        for (adopt.items) |id| x.parts.release(id);
+        adopt.clearRetainingCapacity();
+        owner.pending = null;
+        prompts.forget(key, plan.from);
+        std.log.warn("kv shard: a kept state at {d} tokens has its home in part {d} and its pages in the other (TF_GLM_KV_SHARD); it is evicted, the pass runs cold", .{ plan.from, home });
+    };
     const mine = e.gpa.dupe(u32, plan.marks) catch |err| { // the lane's own marks, freed by its allocator
         e.pages.?.give(adopt.items);
         adopt.clearRetainingCapacity();
@@ -74,6 +83,11 @@ pub fn begin(e: *engine.Engine, s: *const Stream, owner: *Owner, adopt: *std.Arr
     return .{ .from = plan.from, .marks = mine };
 }
 
+/// A kept state's home part (null: unsharded, or the engine holds no such state).
+fn homeOf(e: *const engine.Engine, id: u64) ?u8 {
+    return (e.snaps.get(id) orelse return null).home;
+}
+
 /// TF_GLM_KV_SHARE_UNTWINNED_PCT's default: an untwinned prefill's rate as a percentage of the twinned rate.
 pub const untwinned_pct_default: u32 = 75;
 
diff --git a/zig/src/families/glm/cuda_snapshots.zig b/zig/src/families/glm/cuda_snapshots.zig
index 84cd29e6..3dd0e4e9 100644
--- a/zig/src/families/glm/cuda_snapshots.zig
+++ b/zig/src/families/glm/cuda_snapshots.zig
@@ -212,6 +212,9 @@ pub fn restore(e: anytype, id: u64) !void {
     var plan = try layout.Plan.initForShared(&e.cur.st, &e.c, s.pos, if (e.mtp) s.mtp_len else null, s.shared, own, s.cur);
     if (s.ring_from != null) try plan.outside(try (e.drafter orelse return error.SnapshotSize).ringPtr(e.slot), dflash.ring_bytes);
     if (plan.len != s.len) return error.SnapshotSize;
+    // a state past the shared store's pages is never carried: its sides would cut their pieces apart (the sender
+    // past the pages, the receiver whole), and a rank waiting on rows never sent hangs the pair. Every rank refuses.
+    if (s.shared > 0 and kv_keep.carry(home, hold, e.share.rank) != .none) return error.KvShardNotHome;
     errdefer cuda.completion.drain(e.d, e.stream, "a failed GLM snapshot restore did not drain");
     const t0 = now();
     try pool.moveParts(e.stream, &s.lease, &plan, false, !own or kv_keep.restoresLatent(home, hold, e.share.rank));
diff --git a/zig/src/native/cuda_glm_disk.zig b/zig/src/native/cuda_glm_disk.zig
index 88417178..f9213a86 100644
--- a/zig/src/native/cuda_glm_disk.zig
+++ b/zig/src/native/cuda_glm_disk.zig
@@ -215,9 +215,10 @@ fn blank(ptr: *anyopaque, at: u32) anyerror!api.prompt_cache.Saved {
 
 /// A new kept state of `at` tokens whose leading rows go into pool pages the store holds (`out` their ids, each held
 /// for the caller's tree), its slot past them: a recall's blank under TF_KV_SHARE. The pages lie in one part under
-/// TF_GLM_KV_SHARD (the part with room, as a fresh stream's `Parts.choose`), a recall's home part — the blank's home,
-/// whose rank alone holds its latent rows on the write and the read.
-fn blankPages(ptr: *anyopaque, at: u32, out: *std.ArrayList(u32)) anyerror!api.prompt_cache.Saved {
+/// TF_GLM_KV_SHARD (the part of `near`, a page the tree holds of the prompt, when it has the room: the resume adopts
+/// the tree's pages and is seated there; else the part with room, as a fresh stream's `Parts.choose`), a recall's
+/// home part — the blank's home, whose rank alone holds its latent rows on the write and the read.
+fn blankPages(ptr: *anyopaque, at: u32, near: ?u32, out: *std.ArrayList(u32)) anyerror!api.prompt_cache.Saved {
     const e = engineOf(ptr);
     const rest = Rest.of(e);
     defer rest.done();
@@ -226,7 +227,7 @@ fn blankPages(ptr: *anyopaque, at: u32, out: *std.ArrayList(u32)) anyerror!api.p
     if (n == 0) return error.SnapshotShape;
     const ids = try e.gpa.alloc(u32, n);
     errdefer e.gpa.free(ids);
-    const home: ?u8 = if (p.shard) |x| x.parts.choose(n, null) else null; // the recall's home part
+    const home: ?u8 = if (p.shard) |x| x.parts.choose(n, if (near) |id| p.partOf(id) else null) else null; // the recall's home part
     if (!holdPages(p, home, ids)) return error.LaneMemory;
     errdefer givePages(p, ids);
     const id = try ranks.blank(e, at, home, @intCast(n));
