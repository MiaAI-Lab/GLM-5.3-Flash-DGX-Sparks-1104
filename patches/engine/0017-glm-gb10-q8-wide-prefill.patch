+//! GB10 prompt tile checks use the shared affine fixture, independent packing,
+//! full-shape replacement bytes, cropped-column FP64, and the standard four gates.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const Rig = @import("contract_rig.zig").Rig;
+const c = core.contract.spec;
+const g = core.contract.gates;
+const Affine = core.contract.affine.Affine;
+
+fn depth(s: c.Shape) usize { return 64 + s.k / 64; }
+const full = [_]c.Shape{
+    .{ .rows = 257, .n = 64, .k = 4096 },
+    .{ .rows = 2048, .n = 12576, .k = 4096 },
+    .{ .rows = 4096, .n = 12576, .k = 4096 },
+};
+const cropped = [_]c.Shape{
+    .{ .rows = 257, .n = 64, .k = 4096 },
+    .{ .rows = 512, .n = 128, .k = 4096 },
+    .{ .rows = 37, .n = 1000, .k = 1024 },
+};
+
+pub const Case = struct {
+    rig: Rig,
+    f: cuda.Function,
+    old: cuda.Function,
+    wide: bool,
+    bits: bool,
+    truncate: bool = false,
+    input: ?Affine = null,
+    x: u64 = 0,
+    w: u64 = 0,
+    scales: u64 = 0,
+    out: u64 = 0,
+    base: u64 = 0,
+
+    pub fn deinit(self: *Case) void {
+        self.rig.s.synchronize() catch @panic("wide prompt contract drain");
+        if (self.input) |f| f.deinit();
+        self.rig.deinit();
+    }
+    pub fn kernel(self: *Case) g.Kernel {
+        const name = if (self.truncate) "control: glm wide tile drops the last row tile" else
+            if (self.bits) (if (self.wide) "cuda glm wide q8 FP32 replacement" else "cuda glm wide q8 BF16 replacement") else
+            (if (self.wide) "cuda glm wide q8 FP32 FP64 reference" else "cuda glm wide q8 BF16 FP64 reference");
+        return .{ .spec = .{
+            .name = name, .accum = .f32, .depth = depth,
+            .out = if (self.wide) .f32 else .bf16,
+            .replaces = if (self.bits) "glm_mm8_128, unchanged in this image" else null,
+            .tiles = .{ .{ .size = 256 }, .{ .size = 64, .step = 8, .min = 8 }, .{ .size = 64, .step = 64, .min = 64 } },
+            .served = if (self.bits) &full else &cropped,
+        }, .ctx = self, .vt = &vt, .control = if (self.truncate) .shapes else null };
+    }
+    const vt = g.hooks(Case);
+    pub fn prepare(self: *Case, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.n == 0 or shape.k == 0 or shape.n % 8 != 0 or shape.k % 64 != 0) return false;
+        self.rig.reset();
+        if (self.input) |f| f.deinit();
+        self.input = null;
+        var f = try Affine.init(self.rig.gpu.gpa, shape, 8, 64);
+        errdefer f.deinit();
+        try f.fill(fill, seed);
+        f.form = .dequantized;
+        // The GLM codes are centered at 128. These BF16 scales are also exact FP16
+        // values; -128*scale is exact, so the shared FP64 formula is the same weight.
+        for (f.scales, f.biases) |s, *b| b.* = c.toBf16(-128 * c.fromBf16(s));
+        var arena = std.heap.ArenaAllocator.init(self.rig.gpu.gpa);
+        defer arena.deinit();
+        const a = arena.allocator();
+        const words = try a.alloc(u32, shape.n * shape.k / 4);
+        const scales = try a.alloc(u16, shape.n * shape.k / 64);
+        const groups = shape.k / 64;
+        for (0..shape.n / 8) |tile| for (0..groups) |group| {
+            for (0..8) |col| scales[(tile * groups + group) * 8 + col] = @bitCast(@as(f16, @floatCast(c.fromBf16(f.scales[(tile * 8 + col) * groups + group]))));
+            for (0..32) |lane| {
+                const col = tile * 8 + lane / 4;
+                const at = ((tile * groups + group) * 32 + lane) * 4;
+                @memset(words[at..][0..4], 0);
+                for (0..16) |v| {
+                    const j = v % 4;
+                    const index = (v / 4) * 16 + 2 * (lane % 4) + (j % 2) + (j / 2) * 8;
+                    words[at + v / 4] |= @as(u32, f.codes[col * shape.k + group * 64 + index]) << @as(u5, @intCast(8 * (v % 4)));
+                }
+            }
+        };
+        self.x = try self.rig.input(std.mem.sliceAsBytes(f.x));
+        self.w = try self.rig.input(std.mem.sliceAsBytes(words));
+        self.scales = try self.rig.input(std.mem.sliceAsBytes(scales));
+        self.out = try self.rig.output(shape.rows * shape.n * @as(usize, if (self.wide) 4 else 2));
+        self.base = try self.rig.scratch(shape.rows * shape.n * @as(usize, if (self.wide) 4 else 2));
+        self.input = f;
+        return true;
+    }
+    fn launch(self: *Case, baseline: bool) !void {
+        const shape = self.input.?.shape;
+        var args: cuda.Args = .{};
+        args.add(self.x);
+        args.add(@as(c_longlong, @intCast(shape.k)));
+        args.add(self.w);
+        args.add(self.scales);
+        args.add(if (baseline) self.base else self.out);
+        args.add(@as(u64, 0));
+        args.add(@as(c_int, @intFromBool(self.wide)));
+        args.add(@as(c_int, @intCast(shape.rows)));
+        args.add(@as(c_int, @intCast(shape.n)));
+        args.add(@as(c_int, @intCast(shape.k)));
+        args.add(@as(c_int, 1));
+        const bm: usize = if (baseline) 128 else 256;
+        var blocks = (shape.rows + bm - 1) / bm;
+        if (!baseline and self.truncate and blocks > 1) blocks -= 1;
+        try cuda.launch.launch(if (baseline) self.old else self.f, .{
+            .grid = .{ .x = @intCast((shape.n + 63) / 64), .y = @intCast(blocks) },
+            .block = .{ .x = if (baseline) 256 else 512 },
+            .shared = if (baseline) 61824 else 73984,
+        }, self.rig.s, &args);
+        try self.rig.s.synchronize();
+    }
+    pub fn run(self: *Case) !void { try self.launch(false); }
+    pub fn replaced(self: *Case) ![]const u8 {
+        try self.launch(true);
+        return self.rig.bytes(self.base, self.count() * @as(usize, if (self.wide) 4 else 2));
+    }
+    pub fn count(self: *Case) usize { return self.input.?.outputs(); }
+    pub fn reference(self: *Case, want: []f64, mag: []f64) !void { try self.input.?.reference(want, mag); }
+    pub fn simulate(self: *Case, acc: c.Accum, order: g.Order, out: []f64) !void { try self.input.?.simulate(acc, order, out); }
+};
+
+pub fn collect(gpu: check.Gpu, stream: cuda.Stream, module: cuda.Module, cases: *[5]Case, list: *std.ArrayList(g.Kernel)) !void {
+    const f = try module.function("glm_mm8_256s2");
+    const old = try module.function("glm_mm8_128");
+    try f.allowDynamicShared(73984);
+    try old.allowDynamicShared(61824);
+    for (cases, 0..) |*item, i| {
+        item.* = .{ .rig = .{ .gpu = gpu, .s = stream }, .f = f, .old = old,
+            .wide = i % 2 == 1, .bits = i < 2 or i == 4, .truncate = i == 4 };
+        try list.append(gpu.gpa, item.kernel());
+    }
+}
+
+// Focused diagnostic entry; the same five registrations also live in kernel-contract.
+pub fn run(gpu: check.Gpu) !void {
+    try check.expect(try gpu.ctx.capability() == 121, "wide prompt experiment is GB10 only", .{});
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var module = try cuda.Module.load(gpu.d, cuda.kernels.glm_mm);
+    defer module.unload();
+    var cases: [5]Case = undefined;
+    var list: std.ArrayList(g.Kernel) = .empty;
+    defer list.deinit(gpu.gpa);
+    try collect(gpu, stream, module, &cases, &list);
+    defer for (&cases) |*item| item.deinit();
+    var tally: g.Tally = .{};
+    try g.runAll(gpu.gpa, list.items, 0x6b63, &tally);
+    const f = try module.function("glm_mm8_256s2");
+    const regs = try f.attribute(.num_regs);
+    const shared = try f.attribute(.shared_size_bytes);
+    const local = try f.attribute(.local_size_bytes);
+    const bound = try f.attribute(.max_threads_per_block);
+    const occupancy = try f.occupancy(512, 73984);
+    const limits_ok = regs == 125 and shared == 0 and local == 0 and bound == 512 and occupancy > 0;
+    std.debug.print("{s} glm wide limits: regs={d} static={d} dynamic=73984 local={d} threads={d} blocks/SM={d}\n", .{ if (limits_ok) "PASS" else "FAIL", regs, shared, local, bound, occupancy });
+    std.debug.print("SUMMARY glm wide focused: {d} kernels, {d} passed, {d} failed; {d}/{d} planted controls caught; limits={s}\n", .{ tally.kernels, tally.passed, tally.failed, tally.caught, tally.controls, if (limits_ok) "PASS" else "FAIL" });
+    try check.expect(tally.problems() == 0 and limits_ok, "glm wide focused contract", .{});
+}
