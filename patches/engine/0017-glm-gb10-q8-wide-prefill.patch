+//! Focused executable for the same registrations included by tf-cuda-test kernel-contract.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+pub fn main(init: std.process.Init) !u8 {
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    @import("contract_glm_wide.zig").run(.{ .d = &driver, .ctx = &ctx, .gpa = init.gpa, .io = init.io }) catch |err| {
+        std.debug.print("FAIL glm wide contract: {t}\n", .{err});
+        return 1;
+    };
+    return 0;
+}
