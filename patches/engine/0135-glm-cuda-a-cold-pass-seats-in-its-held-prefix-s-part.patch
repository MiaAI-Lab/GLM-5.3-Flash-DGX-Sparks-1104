diff --git a/zig/src/core/prompt_radix_tree.zig b/zig/src/core/prompt_radix_tree.zig
index a357543e..dc12b307 100644
--- a/zig/src/core/prompt_radix_tree.zig
+++ b/zig/src/core/prompt_radix_tree.zig
@@ -281,6 +281,22 @@ pub const Tree = struct {
         t.prune(n);
     }
 
+    /// Evicts the least valuable idle leaf in the subtree of `n`'s chain (from the root's child it hangs under);
+    /// false when every leaf there is held. A keep whose pages would span the parts frees the other part's branches
+    /// this way, one at a time, until the chain is `alone` and goes whole (dropChain).
+    pub fn evictUnder(t: *Tree, n: *Node) bool {
+        var top: *Node = n;
+        while (top.parent) |up| {
+            if (up.parent == null) break;
+            top = up;
+        }
+        var best: ?*Node = null;
+        t.weakestLeaf(top, &best, null);
+        const leaf = best orelse return false;
+        if (leaf.entry != null) t.evict(leaf) else t.prune(leaf);
+        return true;
+    }
+
     /// Whether nothing but the tree holds the pages of `n`.
     fn idle(t: *const Tree, n: *const Node) bool {
         for (n.pages) |id| if (t.pages.vtable.holders(t.pages.ptr, id) != 1) return false;
