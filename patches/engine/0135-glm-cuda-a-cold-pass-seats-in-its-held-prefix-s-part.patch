+/// TF_KV_SHARE sharded: the part a cold pass with nothing adopted takes, the part of the first page the store holds
+/// of its prompt (a shared system block, an earlier turn), so its keeps share those pages in one part (the seat
+/// falls back to the parts' choice when that part lacks room). Null: unsharded, no store, or nothing held.
+pub fn prefixHome(e: *engine.Engine, s: *const Stream) ?u8 {
+    const prompts = of(e) orelse return null;
+    const p = e.pages orelse return null;
+    _ = p.shard orelse return null;
+    const key = cacheKey(s) orelse return null;
+    const id = prompts.firstHeld(key) orelse return null;
+    return p.partOf(id);
+}
